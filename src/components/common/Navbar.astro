---
// src/components/common/Navbar.astro
import NavbarReact from './Navbar.jsx';
---

<NavbarReact client:load />

<style is:global>
    /* Ajuste global del padding del body para que el contenido no quede debajo del navbar fijo */
    body {
        /* 70px logo + 32px padding vertical = ~102px */
        padding-top: 102px;
    }

    @media (max-width: 1199.98px) {
        body {
            /* En móvil los logos suelen achicarse o la barra cambia, ajustamos si es necesario */
            padding-top: 90px;
        }
    }
</style>