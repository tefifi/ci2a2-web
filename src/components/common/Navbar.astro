---
const links = [
  { name: 'Inicio', href: '/' },
  { name: 'Nosotros', href: '/nosotros' },
  { name: 'Proyectos', href: '/proyectos' },
  { name: 'Noticias', href: '/noticias' },
  { name: 'Publicaciones', href: '/publicaciones' },
];
---
<nav class="navbar navbar-expand-lg navbar-dark bg-ufro fixed-top border-0" id="mainNav">
    <div class="container">
    
    <a class="navbar-brand d-flex align-items-center py-0" href="/">
      
      <img src="/img/logo-ufro.png" alt="Logo UFRO" height="70" class="d-inline-block">
      
      <div class="border-start border-light opacity-50 mx-4" style="height: 50px;"></div>
      
      <img src="/img/logo-ci2a2.png" alt="Logo CI2A2" height="70" class="d-inline-block">
    
    </a>

    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarContent">
      <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center gap-lg-4"> 
        {links.map((link) => (
          <li class="nav-item">
            <a class="nav-link fw-medium text-white hover-pink" href={link.href} style="font-size: 1.05rem;">
              {link.name}
            </a>
          </li>
        ))}
        
        <li class="nav-item ms-lg-3">
            <a href="/admin" class="btn btn-light text-ufro rounded-pill px-4 py-2 fw-bold shadow-sm">
                Acceso Intranet
            </a>
        </li>
      </ul>
    </div>
  </div>
</nav><style>
  :root {
    --ufro-blue: #003767;
    --ufro-pink: #d63384;
  }

  .bg-ufro { background-color: var(--ufro-blue); }
  .text-ufro { color: var(--ufro-blue); }

  #mainNav {
    transition: all 0.3s ease-in-out;
    padding-top: 1rem;    /* Reduje un poco de 1.2 a 1 para que no sea tan gigante */
    padding-bottom: 1rem; 
  }
  
  /* Efecto hover */
  .hover-pink {
    transition: color 0.2s, opacity 0.2s;
    opacity: 0.9;
    text-decoration: none;
  }

  .hover-pink:hover {
    color: var(--ufro-pink) !important;
    opacity: 1;
    font-weight: 600;
  }

  /* --- SOLUCIÓN DEL DESCUADRE --- */
  :global(body) {
    /* Aumentado de 105px a 130px para dar aire al contenido */
    padding-top: 130px; 
  }

  /* Ajuste para móviles */
  @media (max-width: 991.98px) {
    /* Ajustamos el padding del body en móvil porque la barra se achica */
    :global(body) {
        padding-top: 100px;
    }

    .navbar-brand img[alt="Logo UFRO"] { height: 35px; }
    .navbar-brand img[alt="Logo CI2A2"] { height: 50px; }
    
    /* CORRECCIÓN: No se puede usar 'mx-2' dentro de CSS, se usa margin */
    .navbar-brand .border-start { 
        margin-left: 0.5rem !important; 
        margin-right: 0.5rem !important; 
        height: 35px !important; 
    }
  }
</style>