---
/**
 * PageHeader.astro — Encabezado de página estándar CI²A²
 *
 * Reemplaza el bloque <section> de gradiente que estaba
 * copiado inline en cada página (alianzas, biblioteca, agenda,
 * nosotros, publicaciones, transparencia, contacto).
 *
 * Props:
 *   title       - Título principal (h1)  [requerido]
 *   description - Párrafo descriptivo    [opcional]
 *   eyebrow     - Texto pequeño sobre el título (ej: "Vinculación") [opcional]
 */
interface Props {
  title:        string;
  description?: string;
  eyebrow?:     string;
}

const { title, description, eyebrow } = Astro.props;
---

<section class="page-header py-5 text-white position-relative overflow-hidden shadow-sm">
  <div class="container position-relative z-2">
    <div class="col-lg-8">
      {eyebrow && (
        <h6 class="text-pink-light fw-bold text-uppercase ls-3 mb-2 animate-fade-in">
          {eyebrow}
        </h6>
      )}
      <h1 class="display-5 fw-bold mb-2">{title}</h1>
      {description && (
        <p class="opacity-90 mb-0 lead small">{description}</p>
      )}
    </div>
  </div>
</section>

<style>
  .page-header {
    background: var(--gradient-main);
    /* Compensa la altura del navbar fijo (logo 70px + padding ~32px = ~102px)
       Mismo valor que el padding-top del body definido en Navbar.astro */
    padding-top: calc(102px + 2rem);
  }

  @media (max-width: 1199.98px) {
    .page-header {
      padding-top: calc(90px + 2rem);
    }
  }
</style>