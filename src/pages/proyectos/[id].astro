---
import MainLayout from "../../layouts/MainLayout.astro";
import { supabase } from "../../lib/supabase";

export const prerender = false;

const { id } = Astro.params;

// Consultar Supabase
const { data: proyecto, error } = await supabase
    .from("proyectos")
    .select("*")
    .eq("id", id)
    .single();

// Seguridad
if (error || !proyecto) {
    return Astro.redirect("/404");
}

const getStatusStyle = (status: string) => {
    if (!status) return "bg-light text-secondary border-secondary";
    const s = status.toLowerCase();

    // Usamos bg-opacity-25 para que el color de fondo "brille" sobre el azul marino
    if (s.includes("curso") || s.includes("activo") || s.includes("desarrollo"))
        return "bg-success bg-opacity-25 text-success border-success";

    if (s.includes("finalizado") || s.includes("terminado"))
        return "bg-secondary bg-opacity-25 text-white border-secondary"; // Texto blanco para gris

    if (s.includes("plan") || s.includes("diseño"))
        return "bg-warning bg-opacity-25 text-warning border-warning";

    return "bg-light text-secondary border-secondary";
};
---

<MainLayout title={proyecto?.title}>
    {
        /* --- CAMBIO: py-5 a py-4 para reducir altura, y d-flex para control vertical --- */
    }
    <section
        class="text-white py-4 position-relative overflow-hidden d-flex align-items-center"
        style="background: linear-gradient(to right, #003767 0%, #3e2b69 50%, #d63384 100%); min-height: 250px;"
    >
        <div class="container position-relative z-2">
            <div class="row">
                <div class="col-lg-10">


                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span
                            class="badge bg-pink text-white fw-bold px-3 py-1 shadow-sm rounded-pill small"
                        >
                            {proyecto?.area}
                        </span>
                        <span
                            class={`badge ms-2 px-3 py-1 rounded-pill small border ${getStatusStyle(proyecto?.status)}`}
                        >
                            {proyecto?.status}
                        </span>
                    </div>

                    {/* --- CAMBIO: h1 con tamaño responsivo dinámico --- */}
                    <h1 class="responsive-title fw-bold mb-2">
                        {proyecto?.title}
                    </h1>

                    <p class="lead opacity-90 small mb-0 max-width-text">
                        {proyecto?.resumen}
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section class="py-5 bg-light-subtle">
        <div class="container">
            <div class="row g-5">
                {/* COLUMNA IZQUIERDA: Ficha Técnica */}
                <div class="col-lg-4">
                    <div
                        class="card border-0 shadow-sm mb-4 sticky-top"
                        style="top: 100px; z-index: 1;"
                    >
                        <img
                            src={proyecto?.image_url ||
                                "/img/placeholder-project.jpg"}
                            class="card-img-top object-fit-cover"
                            style={`height: 300px; object-position: 50% ${proyecto?.image_position !== null ? proyecto?.image_position : 50}%;`}
                            alt={proyecto?.title}
                        />

                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-3 text-ufro">
                                Ficha Técnica
                            </h5>

                            <ul class="list-unstyled mb-4">
                                {
                                    /* --- CAMBIO: Bloque condicional para Período --- */
                                }
                                {
                                    proyecto?.fecha_inicio && (
                                        <li class="mb-3 d-flex align-items-start gap-3">
                                            <i class="bi bi-calendar-check text-pink fs-5" />
                                            <div>
                                                <span class="d-block fw-bold small text-uppercase text-muted">
                                                    Período
                                                </span>
                                                <span>
                                                    {new Date(
                                                        proyecto.fecha_inicio,
                                                    ).toLocaleDateString(
                                                        "es-CL",
                                                    )}
                                                    {proyecto?.fecha_termino && (
                                                        <>
                                                            {" "}
                                                            -{" "}
                                                            {new Date(
                                                                proyecto.fecha_termino,
                                                            ).toLocaleDateString(
                                                                "es-CL",
                                                            )}
                                                        </>
                                                    )}
                                                </span>
                                            </div>
                                        </li>
                                    )
                                }

                                {/* --- Resto de ítems (Área, etc.) --- */}
                                <li class="mb-3 d-flex align-items-start gap-3">
                                    <i class="bi bi-layers text-pink fs-5"></i>
                                    <div>
                                        <span
                                            class="d-block fw-bold small text-uppercase text-muted"
                                        >
                                            Área
                                        </span>
                                        <span>{proyecto?.area}</span>
                                    </div>
                                </li>

                                {
                                    proyecto?.link_externo && (
                                        <li class="mb-3 d-flex align-items-start gap-3">
                                            <i class="bi bi-link-45deg text-pink fs-5" />
                                            <div>
                                                <span class="d-block fw-bold small text-uppercase text-muted">
                                                    Proyecto
                                                </span>
                                                <a
                                                    href={
                                                        proyecto?.link_externo
                                                    }
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="text-decoration-none text-break link-pink"
                                                >
                                                    Ver enlace
                                                </a>
                                            </div>
                                        </li>
                                    )
                                }
                            </ul>

                            <hr class="opacity-25" />

                            <div class="d-grid">
                                <a
                                    href="/contacto"
                                    class="btn btn-outline-pink rounded-pill fw-bold"
                                >
                                    Consultar por este proyecto
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                {/* COLUMNA DERECHA: Descripción y Socios */}
                <div class="col-lg-8">
                    <div class="bg-white p-5 rounded-4 shadow-sm content-box">
                        <h3
                            class="fw-bold text-dark mb-4 border-bottom pb-3 border-pink"
                        >
                            Descripción del Proyecto
                        </h3>

                        <div
                            class="rich-text"
                            set:html={proyecto?.description}
                        />

                        {
                            ((proyecto?.socios &&
                                proyecto?.socios.length > 0) ||
                                (proyecto?.financiamiento &&
                                    proyecto?.financiamiento.length > 0)) && (
                                <div class="mt-5 pt-4 border-top">
                                    <div class="row g-5">
                                        {proyecto?.socios &&
                                            proyecto?.socios.length > 0 && (
                                                <div class="col-md-6">
                                                    <h6 class="fw-bold text-uppercase text-secondary small mb-4 opacity-75">
                                                        <i class="bi bi-people-fill me-2" />{" "}
                                                        Socios & Colaboradores
                                                    </h6>
                                                    <div class="d-flex flex-wrap align-items-center gap-4">
                                                        {proyecto?.socios.map(
                                                            (socio: any) => (
                                                                <div class="text-center">
                                                                    <div
                                                                        class="mb-2 d-flex align-items-center justify-content-center"
                                                                        style="height: 100px; width: 160px;"
                                                                    >
                                                                        {/* AQUÍ ESTÁ EL CAMBIO: Condicional para el enlace */}
                                                                        {socio.imagen ? (
                                                                            socio.url ? (
                                                                                <a
                                                                                    href={
                                                                                        socio.url
                                                                                    }
                                                                                    target="_blank"
                                                                                    rel="noopener noreferrer"
                                                                                >
                                                                                    <img
                                                                                        src={
                                                                                            socio.imagen
                                                                                        }
                                                                                        alt={
                                                                                            socio.nombre
                                                                                        }
                                                                                        title={
                                                                                            socio.nombre
                                                                                        }
                                                                                        style="max-width: 100%; max-height: 100%; object-fit: contain;"
                                                                                    />
                                                                                </a>
                                                                            ) : (
                                                                                <img
                                                                                    src={
                                                                                        socio.imagen
                                                                                    }
                                                                                    alt={
                                                                                        socio.nombre
                                                                                    }
                                                                                    title={
                                                                                        socio.nombre
                                                                                    }
                                                                                    style="max-width: 100%; max-height: 100%; object-fit: contain;"
                                                                                />
                                                                            )
                                                                        ) : (
                                                                            <i class="bi bi-building fs-1 text-muted opacity-25" />
                                                                        )}
                                                                    </div>
                                                                    <span
                                                                        class="d-block text-muted small text-truncate"
                                                                        style="max-width: 160px;"
                                                                    >
                                                                        {
                                                                            socio.nombre
                                                                        }
                                                                    </span>
                                                                </div>
                                                            ),
                                                        )}
                                                    </div>
                                                </div>
                                            )}

                                        {proyecto?.financiamiento &&
                                            proyecto?.financiamiento.length >
                                                0 && (
                                                <div class="col-md-6">
                                                    <h6 class="fw-bold text-uppercase text-secondary small mb-4 opacity-75">
                                                        <i class="bi bi-cash-coin me-2" />{" "}
                                                        Financiado Por
                                                    </h6>
                                                    <div class="d-flex flex-wrap align-items-center gap-4">
                                                        {proyecto?.financiamiento.map(
                                                            (finan: any) => (
                                                                <div class="text-center">
                                                                    <div
                                                                        class="mb-2 d-flex align-items-center justify-content-center"
                                                                        style="height: 100px; width: 160px;"
                                                                    >
                                                                        {/* AQUÍ ESTÁ EL CAMBIO: Condicional para el enlace */}
                                                                        {finan.imagen ? (
                                                                            finan.url ? (
                                                                                <a
                                                                                    href={
                                                                                        finan.url
                                                                                    }
                                                                                    target="_blank"
                                                                                    rel="noopener noreferrer"
                                                                                >
                                                                                    <img
                                                                                        src={
                                                                                            finan.imagen
                                                                                        }
                                                                                        alt={
                                                                                            finan.nombre
                                                                                        }
                                                                                        title={
                                                                                            finan.nombre
                                                                                        }
                                                                                        style="max-width: 100%; max-height: 100%; object-fit: contain;"
                                                                                    />
                                                                                </a>
                                                                            ) : (
                                                                                <img
                                                                                    src={
                                                                                        finan.imagen
                                                                                    }
                                                                                    alt={
                                                                                        finan.nombre
                                                                                    }
                                                                                    title={
                                                                                        finan.nombre
                                                                                    }
                                                                                    style="max-width: 100%; max-height: 100%; object-fit: contain;"
                                                                                />
                                                                            )
                                                                        ) : (
                                                                            <i class="bi bi-bank fs-1 text-muted opacity-25" />
                                                                        )}
                                                                    </div>
                                                                    <span
                                                                        class="d-block text-muted small text-truncate"
                                                                        style="max-width: 160px;"
                                                                    >
                                                                        {
                                                                            finan.nombre
                                                                        }
                                                                    </span>
                                                                </div>
                                                            ),
                                                        )}
                                                    </div>
                                                </div>
                                            )}
                                    </div>
                                </div>
                            )
                        }

                        {
                            /* --- CAMBIO 3: Botón "Ver más proyectos" ahora es ROSADO (btn-outline-pink) --- */
                        }
                        <div
                            class="mt-5 pt-4 border-top text-center d-flex justify-content-center"
                        >
                            <a
                                href="/proyectos"
                                class="btn btn-outline-pink rounded-pill px-5 py-2 fw-bold d-flex align-items-center gap-2 hover-scale"
                            >
                                Ver más proyectos <i class="bi bi-arrow-right"
                                ></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</MainLayout>

<style>
    /* --- COLORES --- */
    :root {
        --ufro-blue: #003767;
        --ufro-pink: #d63384;
    }
    .bg-ufro {
        background-color: var(--ufro-blue);
    }
    .text-ufro {
        color: var(--ufro-blue);
    }
    .bg-pink {
        background-color: var(--ufro-pink) !important;
    }
    .text-pink {
        color: var(--ufro-pink) !important;
    }
    .border-pink {
        border-color: var(--ufro-pink) !important;
    }
    .link-pink {
        color: var(--ufro-pink);
        transition: 0.2s;
    }
    .link-pink:hover {
        color: #b02a6b;
        text-decoration: underline;
    }

    /* --- INTERACTIVIDAD BOTÓN VOLVER GRIS -> ROSADO --- */
    .back-link-gray {
        color: rgba(
            255,
            255,
            255,
            0.7
        ); /* Gris claro inicial (para fondo oscuro) */
        transition: all 0.3s ease;
        font-weight: 500;
    }
    .back-link-gray:hover {
        color: var(--ufro-pink); /* Hover Rosado */
        transform: translateX(-5px); /* Movimiento izquierda */
    }
    .back-link-gray i {
        display: inline-block;
        transition: transform 0.3s ease;
    }
    .back-link-gray:hover i {
        transform: scale(1.2);
    }

    /* --- BOTÓN ROSADO (Para Consultar y Ver Más) --- */
    .btn-outline-pink {
        color: var(--ufro-pink);
        border: 2px solid var(--ufro-pink);
        transition: all 0.3s ease;
        background: transparent;
    }
    .btn-outline-pink:hover {
        background-color: var(--ufro-pink);
        color: white;
        transform: translateY(-3px);
        box-shadow: 0 5px 15px rgba(214, 51, 132, 0.3);
    }

    /* --- ANIMACIÓN ESCALA --- */
    .hover-scale {
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }
    .hover-scale:hover {
        transform: scale(1.05);
        box-shadow: 0 5px 15px rgba(214, 51, 132, 0.2);
    }

    /* Control de tamaño dinámico para el título */
    .responsive-title {
        font-size: clamp(
            1.8rem,
            4vw,
            2.8rem
        ); /* Mínimo 1.8rem, máximo 2.8rem según el ancho */
        line-height: 1.2;
        max-width: 900px;
    }

    /* Limita el ancho del resumen para que no se estire demasiado */
    .max-width-text {
        max-width: 700px;
        display: -webkit-box;
        -webkit-line-clamp: 2; /* Opcional: limita a 2 líneas en el header si es muy largo */
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Estilo general para las píldoras sobre fondo oscuro */
    .badge.small {
        font-size: 0.75rem !important;
        font-weight: 700 !important;
        letter-spacing: 0.03em;
        padding: 0.4em 0.9em !important;
        border-radius: 50px;

        /* Grosor del borde para que se vea como en tus capturas */
        border-width: 1.5px !important;
        border-style: solid !important;

        /* Efecto para que resalte sobre el fondo azul image_221943.png */
        backdrop-filter: brightness(1.2) blur(4px);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    }

    /* Corrección de color de texto para máxima legibilidad sobre fondo azul */
    .text-success {
        color: #2ecc71 !important;
    } /* Un verde más brillante */
    .text-warning {
        color: #f1c40f !important;
    } /* Un amarillo más sólido */

    /* Si el fondo es el azul marino sólido de la imagen */
    section.bg-dark-blue {
        background-color: #002147; /* O el color exacto de tu imagen image_221943.png */
    }

    /* --- ESTILOS TEXTO --- */
    .rich-text {
        color: #444;
        line-height: 1.8;
    }
    .rich-text h2,
    .rich-text h3 {
        color: var(--ufro-blue);
        font-weight: 700;
        margin-top: 2rem;
        margin-bottom: 1rem;
    }
    .rich-text p {
        margin-bottom: 1.5rem;
    }
    .rich-text ul,
    .rich-text ol {
        margin-bottom: 1.5rem;
        padding-left: 1.5rem;
    }
    .rich-text img {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        margin: 1rem 0;
    }
    .rich-text blockquote {
        border-left: 4px solid var(--ufro-pink);
        padding-left: 1rem;
        font-style: italic;
        color: #666;
    }
</style>
