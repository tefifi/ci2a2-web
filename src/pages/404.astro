---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Página no encontrada">
  <section class="min-vh-100 d-flex align-items-center justify-content-center bg-light py-5">
    <div class="container text-center">

      <div class="mb-4" style="font-size: 6rem; line-height: 1; font-weight: 900; color: #e9ecef;">
        404
      </div>

      <div class="mb-4">
        <div style="width: 60px; height: 4px; background: #d63384; border-radius: 2px; margin: 0 auto;"></div>
      </div>

      <h1 class="fw-bold mb-3" style="color: #003767;">Página no encontrada</h1>
      <p class="text-muted mb-5 mx-auto" style="max-width: 480px;">
        El contenido que buscas no existe o fue eliminado.
        Puedes volver al inicio o explorar otras secciones.
      </p>

      <div class="d-flex justify-content-center gap-3 flex-wrap">
        <a href="/" class="btn btn-primary fw-bold px-5 rounded-pill"
          style="background: #003767; border-color: #003767;">
          <i class="bi bi-house me-2"></i>Ir al inicio
        </a>
      </div>

    </div>
  </section>
</MainLayout>