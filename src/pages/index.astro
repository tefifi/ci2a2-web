---
import MainLayout from "../layouts/MainLayout.astro";
import { supabase } from "../lib/supabase";
import Carrusel from "../components/Carrusel";

// --- 1. CARGA DE CONTENIDOS ---

// Noticias
const { data: noticiasData } = await supabase
    .from("noticias")
    .select("*")
    .order("created_at", { ascending: false })
    .limit(6);
const noticiasSeguras = noticiasData || [];

// Proyectos
const { data: proyectosData } = await supabase
    .from("proyectos")
    .select("*")
    .eq("status", "En curso")
    .order("created_at", { ascending: false })
    .limit(6);
const proyectos = proyectosData || [];

// Publicaciones
const { data: publicacionesData } = await supabase
    .from("publicaciones")
    .select("*")
    .eq("is_visible", true)
    .order("year", { ascending: false })
    .limit(3);
const publicaciones = publicacionesData || [];

// Banners
const { data: bannersData } = await supabase
    .from("banners")
    .select("*")
    .eq("active", true)
    .order("order", { ascending: true });
const bannersSeguros = bannersData || [];

// --- 2. ALIANZAS ---
let alianzas = [];
const { data: dataAlianzas, error: errorAlianzas } = await supabase
    .from("alianzas")
    .select("*")
    .order("nombre", { ascending: true });

if (!errorAlianzas) alianzas = dataAlianzas || [];

const normalizarCategoria = (valor: any) => {
    if (!valor) return "Otras";
    const v = valor.trim();
    if (v === "Cliente") return "Clientes";
    if (v === "Alianza") return "Alianzas";
    if (v === "Universidad Socia") return "Universidades Socias";
    return v;
};

// Agrupación simple
const alianzasPorCategoria: Record<string, any[]> = {};

alianzas.forEach((item) => {
    const raw = item.tipo_entidad || item.categoria || "Otras";
    const cat = normalizarCategoria(raw);

    if (!alianzasPorCategoria[cat]) {
        alianzasPorCategoria[cat] = [];
    }
    alianzasPorCategoria[cat].push(item);
});

const ordenSecciones = [
    "Clientes",
    "Alianzas",
    "Universidades Socias",
    "Ecosistema",
];
const categoriasAmostrar = [
    ...ordenSecciones.filter((cat) => alianzasPorCategoria[cat]),
    ...Object.keys(alianzasPorCategoria).filter(
        (cat) => !ordenSecciones.includes(cat),
    ),
];

// Líneas de Investigación
const lineasInvestigacion = [
    {
        titulo: "Smart Agro",
        desc: "IA para la gestión hídrica y optimización de cultivos.",
        icon: "bi-flower1",
    },
    {
        titulo: "Salud y Bienestar",
        desc: "Diagnóstico asistido y telemedicina inteligente.",
        icon: "bi-heart-pulse",
    },
    {
        titulo: "Industria 4.0",
        desc: "Automatización y optimización de procesos productivos.",
        icon: "bi-gear-wide-connected",
    },
    {
        titulo: "Gobernanza de Datos",
        desc: "Políticas públicas basadas en evidencia y ética de datos.",
        icon: "bi-bank",
    },
];

// --- 3. CIFRAS ---
const { count: totalEquipo } = await supabase
    .from("colaboradores")
    .select("*", { count: "exact", head: true });
const { count: totalProyectos } = await supabase
    .from("proyectos")
    .select("*", { count: "exact", head: true });
const { count: totalAlianzasCount } = await supabase
    .from("alianzas")
    .select("*", { count: "exact", head: true });
const { count: totalPublicaciones } = await supabase
    .from("publicaciones")
    .select("*", { count: "exact", head: true });

// --- 4. CONFIGURACIÓN ---
const { data: configData } = await supabase.from("config_graficos").select("*");
// 'as any' silencia errores de tipo en la configuración
const configInicial = {
    stat_colaboradores: true,
    stat_proyectos: true,
    stat_alianzas: true,
    stat_papers: true,
};
const config = (configData || []).reduce((acc, item) => {
    acc[item.clave] = item.activo;
    return acc;
}, configInicial);

const mostrarSeccionImpacto =
    config.stat_colaboradores ||
    config.stat_proyectos ||
    config.stat_alianzas ||
    config.stat_papers;

function formatAuthorsHome(autoresStr: any) {
    if (!autoresStr) return "Autoría CI2A2";
    const autores = autoresStr.split(";");
    return autores.length > 2 ? `${autores[0].trim()} et al.` : autoresStr;
}
---

<MainLayout title="Inicio">
    <section class="bg-light pb-0 pt-4">
        <div class="container">
            <div
                id="mainBannerCarousel"
                class="carousel slide"
                data-bs-ride="carousel"
            >
                <div
                    class="carousel-inner shadow-lg rounded-4 overflow-hidden bg-white"
                >
                    {
                        bannersSeguros && bannersSeguros.length > 0 ? (
                            bannersSeguros.map((banner, index) => (
                                <div
                                    class={`carousel-item ${index === 0 ? "active" : ""}`}
                                    data-bs-interval="5000"
                                >
                                    <div
                                        style={{
                                            width: "100%",
                                            aspectRatio: "21/7",
                                            overflow: "hidden",
                                        }}
                                    >
                                        {banner.link ? (
                                            <a
                                                href={banner.link}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                            >
                                                <img
                                                    src={banner.image_url}
                                                    class="d-block w-100 h-100 object-fit-cover"
                                                    alt={
                                                        banner.title ||
                                                        "Banner del CI²A²"
                                                    }
                                                    loading="lazy"
                                                    width="1250"
                                                    height="450"
                                                />
                                            </a>
                                        ) : (
                                            <img
                                                src={banner.image_url}
                                                class="d-block w-100 h-100 object-fit-cover"
                                                alt={
                                                    banner.title ||
                                                    "Banner del CI²A²"
                                                }
                                                loading="lazy"
                                                width="1250"
                                                height="450"
                                            />
                                        )}
                                    </div>
                                </div>
                            ))
                        ) : (
                            <div class="carousel-item active">
                                <div
                                    style={{
                                        width: "100%",
                                        aspectRatio: "21/9",
                                    }}
                                    class="bg-secondary d-flex align-items-center justify-content-center text-white"
                                >
                                    <p>Cargando banners...</p>
                                </div>
                            </div>
                        )
                    }
                </div>
                {
                    bannersSeguros && bannersSeguros.length > 1 && (
                        <div class="custom-indicators-container">
                            <div class="carousel-indicators">
                                {bannersSeguros.map((_, index) => (
                                    <button
                                        type="button"
                                        data-bs-target="#mainBannerCarousel"
                                        data-bs-slide-to={index}
                                        class={index === 0 ? "active" : ""}
                                        aria-current={
                                            index === 0 ? "true" : "false"
                                        }
                                    />
                                ))}
                            </div>
                        </div>
                    )
                }
            </div>
        </div>
    </section>

    <section class="py-6 bg-white">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <h6 class="text-pink fw-bold text-uppercase ls-2 mb-3">
                        Sobre el Centro
                    </h6>
                    <h2 class="fw-bold text-dark mb-4">
                        Liderando la revolución de la IA en el sur de Chile
                    </h2>
                    <p class="text-muted lead mb-4">
                        El <strong>CI²A²</strong> nace con la misión de impulsar la
                        investigación, formación y transferencia tecnológica en Inteligencia
                        Artificial, contribuyendo al desarrollo científico y social
                        del territorio.
                    </p>
                    <p class="text-secondary mb-4">
                        En el marco de la iniciativa Ingeniería 2030 de la
                        Facultad de Ingeniería y Ciencias, el CI²A²
                        fortalece la I+D aplicada, promoviendo un ecosistema de
                        innovación que articula academia, industria y sector
                        público, con foco en el impacto y la transferencia de
                        conocimiento.
                    </p>
                    <div class="d-flex gap-4 border-top pt-4">
                        <div>
                            <h3 class="fw-bold text-ufro mb-0">4+</h3>
                            <small
                                class="text-muted"
                                style="font-size: 0.85rem;"
                                >Áreas Estratégicas</small
                            >
                        </div>
                        <div class="vr opacity-25"></div>
                        <div>
                            <h3 class="fw-bold text-ufro mb-0">2025</h3>
                            <small
                                class="text-muted"
                                style="font-size: 0.85rem;">Fundación</small
                            >
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="position-relative ps-lg-4">
                        <img
                            src="https://images.unsplash.com/photo-1573164713988-8665fc963095?auto=format&fit=crop&q=80"
                            alt="Investigadores UFRO"
                            class="img-fluid rounded-4 shadow position-relative z-1"
                        />
                    </div>
                </div>
            </div>
        </div>
    </section>

    {
        mostrarSeccionImpacto && (
            <section
                class="py-6 position-relative text-white overflow-hidden"
                style="background-color: var(--ufro-blue);"
            >
                <div
                    class="position-absolute top-0 start-0 w-100 h-100 opacity-10"
                    style="background-image: radial-gradient(circle at 10% 20%, rgba(255,255,255,0.3) 0%, transparent 20%);"
                />

                <div class="container position-relative z-2">
                    <div class="text-center mb-5">
                        <h6 class="text-pink fw-bold text-uppercase ls-2 mb-2">
                            Nuestra Gestión
                        </h6>
                        <h3 class="fw-bold text-white display-6">
                            Impacto en Cifras
                        </h3>
                    </div>

                    <div class="row g-4 text-center justify-content-center">
                        {config.stat_colaboradores && (
                            <div class="col-6 col-md-3">
                                <div class="p-4 border border-white border-opacity-25 rounded-4 h-100 bg-white bg-opacity-10 backdrop-blur hover-lift transition-all">
                                    <i class="bi bi-people-fill fs-2 text-pink mb-3 d-block" />
                                    <h2
                                        class="display-5 fw-bold mb-0 counter"
                                        data-target={totalEquipo || 0}
                                    >
                                        0
                                    </h2>
                                    <p class="text-white-50 text-uppercase small fw-bold mt-2 mb-0 ls-1">
                                        Colaboradores
                                    </p>
                                </div>
                            </div>
                        )}
                        {config.stat_proyectos && (
                            <div class="col-6 col-md-3">
                                <div class="p-4 border border-white border-opacity-25 rounded-4 h-100 bg-white bg-opacity-10 backdrop-blur hover-lift transition-all">
                                    <i class="bi bi-kanban-fill fs-2 text-pink mb-3 d-block" />
                                    <h2
                                        class="display-5 fw-bold mb-0 counter"
                                        data-target={totalProyectos || 0}
                                    >
                                        0
                                    </h2>
                                    <p class="text-white-50 text-uppercase small fw-bold mt-2 mb-0 ls-1">
                                        Proyectos I+D
                                    </p>
                                </div>
                            </div>
                        )}
                        {config.stat_alianzas && (
                            <div class="col-6 col-md-3">
                                <div class="p-4 border border-white border-opacity-25 rounded-4 h-100 bg-white bg-opacity-10 backdrop-blur hover-lift transition-all">
                                    <i class="bi bi-diagram-3-fill fs-2 text-pink mb-3 d-block" />
                                    <h2
                                        class="display-5 fw-bold mb-0 counter"
                                        data-target={totalAlianzasCount || 0}
                                    >
                                        0
                                    </h2>
                                    <p class="text-white-50 text-uppercase small fw-bold mt-2 mb-0 ls-1">
                                        Alianzas
                                    </p>
                                </div>
                            </div>
                        )}
                        {config.stat_papers && (
                            <div class="col-6 col-md-3">
                                <div class="p-4 border border-white border-opacity-25 rounded-4 h-100 bg-white bg-opacity-10 backdrop-blur hover-lift transition-all">
                                    <i class="bi bi-file-earmark-richtext-fill fs-2 text-pink mb-3 d-block" />
                                    <h2
                                        class="display-5 fw-bold mb-0 counter"
                                        data-target={totalPublicaciones || 0}
                                    >
                                        0
                                    </h2>
                                    <p class="text-white-50 text-uppercase small fw-bold mt-2 mb-0 ls-1">
                                        Papers
                                    </p>
                                </div>
                            </div>
                        )}
                    </div>
                </div>
            </section>
        )
    }

    <section class="py-6 bg-light">
        <div class="container">
            <div class="text-center mb-5">
                <h6 class="text-pink fw-bold text-uppercase ls-2">
                    Enfoque Estratégico
                </h6>
                <h2 class="fw-bold text-dark">Líneas de Investigación</h2>
                <div
                    class="mx-auto mt-3 bg-pink rounded-pill"
                    style="width: 50px; height: 3px;"
                >
                </div>
            </div>

            <div class="row g-4">
                {
                    lineasInvestigacion.map((linea) => (
                        <div class="col-md-6 col-lg-3">
                            <div class="card h-100 border-0 shadow-sm p-4 hover-lift card-research position-relative overflow-hidden bg-white">
                                <div
                                    class="position-absolute top-0 start-0 h-100 bg-pink"
                                    style="width: 4px;"
                                />
                                <div
                                    class="icon-box bg-light text-pink mb-4 rounded-circle d-flex align-items-center justify-content-center"
                                    style="width: 60px; height: 60px;"
                                >
                                    <i class={`bi ${linea.icon} fs-3`} />
                                </div>
                                <h5 class="fw-bold text-dark mb-3">
                                    {linea.titulo}
                                </h5>
                                <p class="text-muted small mb-0 opacity-75">
                                    {linea.desc}
                                </p>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <section id="proyectos" class="py-6 bg-white border-top">
        <div class="container">
            <div
                class="d-flex flex-column flex-md-row justify-content-between align-items-end mb-5 gap-3"
            >
                <div class="text-center text-md-start w-100">
                    <h6 class="text-pink fw-bold text-uppercase ls-2">
                        Innovación Aplicada
                    </h6>
                    <h2 class="fw-bold text-dark">Proyectos Destacados</h2>
                </div>
                <a
                    href="/proyectos"
                    class="btn btn-outline-pink rounded-pill px-4 py-2 fw-bold hover-scale text-nowrap align-self-center align-self-md-end shadow-sm"
                >
                    Ver Portafolio <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
            {
                proyectos && proyectos.length > 0 ? (
                    <Carrusel
                        client:load
                        tipo="proyectos"
                        banners={[]}
                        datos={
                            proyectos.map((p) => ({
                                id: p.id,
                                title: p.title || p.nombre || "Sin Título", // Esto es vital
                                image_url:
                                    p.imagen_url ||
                                    p.portada_url ||
                                    p.image_url,
                                resumen:
                                    p.descripcion ||
                                    p.resumen ||
                                    "Sin descripción disponible.",
                                area: p.area || p.categoria || "I+D",
                                status: p.status || p.estado || "En curso",
                            })) as any
                        }
                    />
                ) : (
                    <div class="text-center py-5">
                        <p class="text-muted">Cargando proyectos...</p>
                    </div>
                )
            }
        </div>
    </section>

    <section
        class="py-6 text-white position-relative overflow-hidden"
        style="background: linear-gradient(135deg, #003767 0%, #d63384 100%);"
    >
        <div class="container position-relative z-2">
            <div class="row align-items-center g-5">
                <div class="col-lg-5">
                    <h6 class="text-pink fw-bold text-uppercase ls-2 mb-2">
                        Talento Joven
                    </h6>
                    <h2 class="fw-bold mb-4 display-5 text-white">
                        Formación y Docencia
                    </h2>
                    <p class="lead opacity-90 mb-5">
                        Vinculamos a estudiantes con proyectos de frontera.
                        Ofrecemos oportunidades reales para tu desarrollo
                        profesional en un entorno de alto nivel.
                    </p>
                    <a
                        href="/contacto"
                        class="btn btn-action-white rounded-pill px-5 py-3 fw-bold shadow-lg d-inline-flex align-items-center gap-2"
                    >
                        <span>¡Quiero participar!</span>
                        <i class="bi bi-chevron-right small"></i>
                    </a>
                </div>
                <div class="col-lg-6 offset-lg-1">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <a
                                href="/contacto"
                                class="text-decoration-none text-white h-100 d-block"
                            >
                                <div
                                    class="p-4 bg-white bg-opacity-10 rounded-4 border border-white border-opacity-25 h-100 hover-glass text-center text-md-start transition-all cursor-pointer"
                                >
                                    <div
                                        class="mb-3 d-inline-block p-3 rounded-circle bg-white bg-opacity-10"
                                    >
                                        <i
                                            class="bi bi-mortarboard fs-3 text-white"
                                        ></i>
                                    </div>
                                    <h5 class="fw-bold text-white">
                                        Tesis y Articulación
                                    </h5>
                                    <p class="small opacity-75 mb-0">
                                        Desarrolla tu memoria de título con
                                        posibilidad de <strong
                                            >articulación directa con el
                                            Magíster</strong
                                        >.
                                    </p>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a
                                href="/contacto"
                                class="text-decoration-none text-white h-100 d-block"
                            >
                                <div
                                    class="p-4 bg-white bg-opacity-10 rounded-4 border border-white border-opacity-25 h-100 hover-glass text-center text-md-start transition-all cursor-pointer"
                                >
                                    <div
                                        class="mb-3 d-inline-block p-3 rounded-circle bg-white bg-opacity-10"
                                    >
                                        <i
                                            class="bi bi-briefcase fs-3 text-white"
                                        ></i>
                                    </div>
                                    <h5 class="fw-bold text-white">
                                        Prácticas
                                    </h5>
                                    <p class="small opacity-75 mb-0">
                                        Oportunidades de <strong
                                            >Práctica Controlada</strong
                                        > y Profesional en proyectos de innovación.
                                    </p>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-6 bg-light overflow-hidden">
        <div class="container">
            <div class="text-center mb-5">
                <h6 class="text-pink fw-bold text-uppercase ls-2">
                    Actualidad
                </h6>
                <h2 class="fw-bold text-dark">Noticias y Eventos</h2>
            </div>

            {/* AQUÍ: Usamos 'as any' para borrar errores de TypeScript */}
            {
                noticiasSeguras && noticiasSeguras.length > 0 ? (
                    <Carrusel
                        client:load
                        tipo="noticias"
                        banners={[]}
                        datos={
                            (noticiasSeguras || []).map((n) => ({
                                id: n.id,
                                title: n.titulo,
                                image_url: n.image_url,
                                resumen: n.bajada || n.resumen,
                                area: n.categoria,
                                fecha: new Date(
                                    n.created_at,
                                ).toLocaleDateString("es-CL"),
                            })) as any
                        }
                    />
                ) : (
                    <div class="text-center py-5">
                        <p class="text-muted">Cargando noticias...</p>
                    </div>
                )
            }

            <div class="text-center mt-3">
                <a
                    href="/noticias"
                    class="btn btn-outline-pink rounded-pill px-5 py-2 fw-bold hover-scale shadow-sm d-inline-flex align-items-center gap-2"
                >
                    Ver todas las noticias <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </section>

    <section class="py-6 bg-white">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-4 mb-4 mb-lg-0">
                    <h6 class="text-pink fw-bold text-uppercase ls-2">
                        Ciencia Abierta
                    </h6>
                    <h2 class="fw-bold text-dark mb-3">
                        Producción Científica
                    </h2>
                    <p class="text-muted mb-4">
                        Difundimos el conocimiento a través de revistas
                        indexadas y conferencias de alto impacto.
                    </p>
                    <a
                        href="/publicaciones"
                        class="btn btn-outline-pink rounded-pill px-4 shadow-sm hover-lift fw-bold"
                        >Ver repositorio</a
                    >
                </div>

                <div class="col-lg-8">
                    <div
                        class="list-group list-group-flush border-start border-3 ps-4 mt-4 mt-lg-0"
                        style="border-color: #d63384 !important;"
                    >
                        {
                            publicaciones && publicaciones.length > 0 ? (
                                publicaciones.map((pub) => (
                                    <div class="mb-4">
                                        <h6 class="fw-bold text-dark mb-1">
                                            {pub.url ? (
                                                <a
                                                    href={pub.url}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="text-dark text-decoration-none hover-primary pub-link"
                                                >
                                                    {pub.title}{" "}
                                                    <i
                                                        class="bi bi-box-arrow-up-right small text-muted ms-1"
                                                        style="font-size: 0.7em;"
                                                    />
                                                </a>
                                            ) : (
                                                pub.title
                                            )}
                                        </h6>
                                        <p class="small text-muted mb-0">
                                            <span class="badge bg-light text-dark border me-1">
                                                {pub.year}
                                            </span>{" "}
                                            {formatAuthorsHome(pub.autores)}
                                        </p>
                                    </div>
                                ))
                            ) : (
                                <div class="text-muted fst-italic">
                                    Cargando publicaciones...
                                </div>
                            )
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-6 bg-light border-top">
        <div class="container">
            <div class="text-center mb-5">
                <p class="small text-uppercase text-muted fw-bold mb-4 ls-2">
                    Colaboración y Vinculación
                </p>

                {
                    alianzas.length === 0 ? (
                        <div class="text-muted">Cargando alianzas...</div>
                    ) : (
                        categoriasAmostrar.map((categoria) => (
                            <div class="mb-5">
                                <h6
                                    class="text-ufro fw-bold text-uppercase opacity-75 mb-3"
                                    style="font-size: 0.8rem;"
                                >
                                    {categoria}
                                </h6>
                                <div class="d-flex justify-content-center align-items-center gap-4 flex-wrap colorful-logos">
                                    {(
                                        alianzasPorCategoria[categoria] || []
                                    ).map((item) => (
                                        <a
                                            href={item.link_web || "#"}
                                            target={
                                                item.link_web
                                                    ? "_blank"
                                                    : "_self"
                                            }
                                            class="logo-item text-decoration-none text-center"
                                            title={item.nombre}
                                        >
                                            {item.logo_url ? (
                                                <img
                                                    src={item.logo_url}
                                                    alt={item.nombre}
                                                    class="img-fluid"
                                                    style="max-height: 50px; max-width: 120px;"
                                                    loading="lazy"
                                                />
                                            ) : (
                                                <span class="text-muted fw-bold small">
                                                    {item.nombre}
                                                </span>
                                            )}
                                        </a>
                                    ))}
                                </div>
                            </div>
                        ))
                    )
                }

                <div class="mt-4">
                    <a
                        href="/alianzas"
                        class="btn btn-link text-pink fw-bold text-decoration-none hover-scale"
                    >
