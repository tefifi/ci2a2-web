---
import MainLayout from "../layouts/MainLayout.astro";
import { supabase } from "../lib/supabase";

//  CARGA DE DATOS 
const { data: proyectos } = await supabase
    .from("proyectos")
    .select("*")
    .eq("status", "En Curso")
    .order("created_at", { ascending: false })
    .limit(3);

const { data: noticias, error: errorNoticias } = await supabase
    .from("noticias")
    .select("*")
    .order("created_at", { ascending: false })
    .limit(3);

const noticiasSeguras = errorNoticias || !noticias ? [] : noticias;

//  DATOS ESTÁTICOS DEL PDF 
const lineasInvestigacion = [
    {
        titulo: "Smart Agro",
        desc: "IA para la gestión hídrica y optimización de cultivos.",
        icon: "bi-flower1",
    },
    {
        titulo: "Salud y Bienestar",
        desc: "Diagnóstico asistido y telemedicina inteligente.",
        icon: "bi-heart-pulse",
    },
    {
        titulo: "Industria 4.0",
        desc: "Automatización y optimización de procesos productivos.",
        icon: "bi-gear-wide-connected",
    },
    {
        titulo: "Gobernanza de Datos",
        desc: "Políticas públicas basadas en evidencia y ética de datos.",
        icon: "bi-bank",
    },
];
---

<MainLayout title="Inicio">
    <section
        class="hero-section d-flex align-items-center position-relative text-white"
    >
        <div class="overlay-gradient" style="pointer-events: none;"></div>
        <div class="container position-relative z-2">
            <div class="row align-items-center">
                <div class="col-lg-8 animate-fade-up">
                    <div
                        class="d-inline-block border border-light border-opacity-25 rounded-pill px-3 py-1 mb-4 backdrop-blur"
                    >
                        <small class="fw-bold tracking-wide text-uppercase"
                            >Universidad de La Frontera</small
                        >
                    </div>
                    <h1 class="display-3 fw-bold mb-4 lh-sm">
                        Centro de Investigación en <br />
                        <span class="text-cyan"
                            >Inteligencia Artificial Aplicada</span
                        >
                    </h1>
                    <p
                        class="lead opacity-90 mb-5 fw-light"
                        style="max-width: 650px;"
                    >
                        Generamos soluciones tecnológicas transdisciplinarias
                        desde La Araucanía, articulando capacidades académicas
                        para resolver desafíos de la industria, la salud y la
                        gobernanza.
                    </p>
                    <div class="d-flex flex-wrap gap-3">
                        <a
                            href="#proyectos"
                            class="btn btn-light text-ufro fw-bold rounded-pill px-4 py-3 shadow-lg hover-scale"
                        >
                            Conoce nuestros proyectos
                        </a>
                        <a
                            href="mailto:contacto.ci2a2@ufro.cl"
                            class="btn btn-outline-light fw-bold rounded-pill px-4 py-3 hover-scale"
                        >
                            Colabora con nosotros
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div
            class="position-absolute end-0 bottom-0 p-5 opacity-10 d-none d-lg-block"
        >
            <i class="bi bi-cpu-fill" style="font-size: 20rem;"></i>
        </div>
    </section>

    <section class="py-6 bg-white">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <h6 class="text-ufro fw-bold text-uppercase ls-2 mb-3">
                        Sobre el Centro
                    </h6>
                    <h2 class="fw-bold text-dark mb-4">
                        Liderando la revolución de la IA en el sur de Chile
                    </h2>
                    <p class="text-muted lead mb-4">
                        El <strong>CI²A²</strong> nace con la misión de impulsar la
                        investigación, formación y transferencia tecnológica en Inteligencia
                        Artificial, contribuyendo al desarrollo científico y social
                        del territorio.
                    </p>
                    <p class="text-secondary mb-4">
                        Perteneciente a la Universidad de La Frontera, nuestro
                        centro actúa como un núcleo articulador entre la
                        academia, el sector productivo y el sector público,
                        alineado con la Estrategia Regional de Desarrollo 2040.
                    </p>

                    <div class="d-flex gap-5 border-top pt-4">
                        <div>
                            <h3 class="fw-bold text-ufro mb-0">4+</h3>
                            <small
                                class="text-uppercase text-muted"
                                style="font-size: 0.75rem;"
                                >Áreas Estratégicas</small
                            >
                        </div>
                        <div>
                            <h3 class="fw-bold text-ufro mb-0">2025</h3>
                            <small
                                class="text-uppercase text-muted"
                                style="font-size: 0.75rem;"
                                >Año de Fundación</small
                            >
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="position-relative">
                        <img
                            src="https://images.unsplash.com/photo-1573164713988-8665fc963095?auto=format&fit=crop&q=80"
                            alt="Investigadores UFRO"
                            class="img-fluid rounded-4 shadow-lg position-relative z-1"
                        />
                        <div
                            class="position-absolute top-0 end-0 bg-ufro rounded-4 w-100 h-100 mt-4 ms-4 opacity-10 z-0"
                        >
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-6 bg-light-subtle">
        <div class="container">
            <div class="text-center mb-5">
                <h6 class="text-ufro fw-bold text-uppercase ls-2">
                    Enfoque Estratégico
                </h6>
                <h2 class="fw-bold text-dark">
                    Líneas de Investigación y Desarrollo
                </h2>
            </div>

            <div class="row g-4">
                {
                    lineasInvestigacion.map((linea) => (
                        <div class="col-md-6 col-lg-3">
                            <div class="card h-100 border-0 shadow-sm p-4 hover-up card-linea">
                                <div
                                    class="icon-box bg-primary-subtle text-primary mb-3 rounded-circle d-flex align-items-center justify-content-center"
                                    style="width: 60px; height: 60px;"
                                >
                                    <i class={`bi ${linea.icon} fs-3`} />
                                </div>
                                <h5 class="fw-bold text-dark mb-3">
                                    {linea.titulo}
                                </h5>
                                <p class="text-muted small mb-0">
                                    {linea.desc}
                                </p>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <section
        id="proyectos"
        class="py-6 bg-white border-top"
        style="scroll-margin-top: 100px;"
    >
        <div class="container">
            <div class="d-flex justify-content-between align-items-end mb-5">
                <div>
                    <h6 class="text-ufro fw-bold text-uppercase ls-2">
                        Impacto Real
                    </h6>
                    <h2 class="fw-bold text-dark">Proyectos Destacados</h2>
                </div>
                <a
                    href="/proyectos"
                    class="btn btn-outline-primary rounded-pill px-4 d-none d-md-inline-block"
                    >Ver todo el portafolio</a
                >
            </div>

            {
                proyectos && proyectos.length > 0 ? (
                    <div class="row g-4">
                        {proyectos.map((p) => (
                            <div class="col-lg-4 col-md-6">
                                <article class="card h-100 border-0 shadow-sm project-card overflow-hidden">
                                    <div
                                        class="position-relative"
                                        style="height: 220px;"
                                    >
                                        <img
                                            src={
                                                p.image_url ||
                                                "/img/placeholder-project.jpg"
                                            }
                                            class="w-100 h-100 object-fit-cover"
                                            alt={p.title}
                                        />
                                        <span class="badge bg-ufro position-absolute top-0 end-0 m-3 shadow-sm">
                                            {p.area}
                                        </span>
                                    </div>
                                    <div class="card-body p-4 d-flex flex-column">
                                        <h5 class="fw-bold text-dark mb-2 fs-5">
                                            {p.title}
                                        </h5>
                                        <p class="text-muted small line-clamp-3 mb-3 flex-grow-1">
                                            {p.resumen ||
                                                "Sin descripción disponible."}
                                        </p>
                                        <div class="d-flex justify-content-between align-items-center border-top pt-3 mt-auto">
                                            <span class="badge bg-light text-dark border">
                                                <i class="bi bi-circle-fill text-success me-1 small" />{" "}
                                                {p.status}
                                            </span>
                                            <a
                                                href={`/proyectos/${p.id}`}
                                                class="text-ufro fw-bold text-decoration-none small stretched-link"
                                            >
                                                Ver detalles{" "}
                                                <i class="bi bi-arrow-right" />
                                            </a>
                                        </div>
                                    </div>
                                </article>
                            </div>
                        ))}
                    </div>
                ) : (
                    <div class="text-center py-5">
                        <p class="text-muted">
                            No hay proyectos destacados para mostrar en este
                            momento.
                        </p>
                        <a
                            href="/proyectos"
                            class="btn btn-primary rounded-pill"
                        >
                            Ver todos los proyectos
                        </a>
                    </div>
                )
            }

            <div class="text-center mt-4 d-md-none">
                <a
                    href="/proyectos"
                    class="btn btn-outline-primary rounded-pill w-100"
                    >Ver todos</a
                >
            </div>
        </div>
    </section>

    <section class="py-6 bg-ufro text-white position-relative overflow-hidden">
        <div class="container position-relative z-2">
            <div class="row align-items-center">
                <div class="col-lg-5 mb-4 mb-lg-0">
                    <h6 class="text-info fw-bold text-uppercase ls-2 mb-2">
                        Capital Humano
                    </h6>
                    <h2 class="fw-bold mb-4">Formación y Docencia</h2>
                    <p class="opacity-90 mb-4">
                        Vinculamos a estudiantes de pre y postgrado con
                        proyectos de frontera. Ofrecemos oportunidades de tesis,
                        prácticas y participación en papers científicos.
                    </p>
                    <a
                        href="/contacto"
                        class="btn btn-light text-ufro rounded-pill px-4 fw-bold"
                        >Soy estudiante y quiero participar</a
                    >
                </div>
                <div class="col-lg-6 offset-lg-1">
                    <div class="row g-3">
                        <div class="col-6">
                            <div
                                class="p-4 bg-white bg-opacity-10 rounded-3 border border-light border-opacity-25 h-100"
                            >
                                <i class="bi bi-mortarboard fs-2 text-info mb-3"
                                ></i>
                                <h5 class="fw-bold">Postgrado</h5>
                                <p class="small opacity-75 mb-0">
                                    Vinculación con Doctorado en Ciencias de la
                                    Ingeniería y Magíster.
                                </p>
                            </div>
                        </div>
                        <div class="col-6">
                            <div
                                class="p-4 bg-white bg-opacity-10 rounded-3 border border-light border-opacity-25 h-100"
                            >
                                <i
                                    class="bi bi-file-earmark-text fs-2 text-info mb-3"
                                ></i>
                                <h5 class="fw-bold">Tesis I+D</h5>
                                <p class="small opacity-75 mb-0">
                                    Desarrolla tu memoria de título en proyectos
                                    financiados.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <i
            class="bi bi-share position-absolute text-white opacity-05"
            style="font-size: 30rem; right: -10%; top: -10%;"></i>
    </section>

    <section class="py-6 bg-white">
        <div class="container">
            <div class="row">
                <div class="col-lg-4">
                    <h6 class="text-ufro fw-bold text-uppercase ls-2">
                        Producción Científica
                    </h6>
                    <h2 class="fw-bold text-dark mb-3">
                        Publicaciones Recientes
                    </h2>
                    <p class="text-muted mb-4">
                        Difundimos el conocimiento generado a través de revistas
                        indexadas y conferencias internacionales.
                    </p>
               
                </div>
                <div class="col-lg-8">
                    <div
                        class="list-group list-group-flush border-start border-3 border-primary ps-4"
                    >
                        <div class="mb-4">
                            <h6 class="fw-bold text-dark mb-1">
                                Deep Learning approaches for precision
                                agriculture in Southern Chile
                            </h6>
                            <p class="small text-muted mb-0">
                                IEEE Access (2024) • J. Pérez, M. González et
                                al.
                            </p>
                        </div>
                        <div class="mb-4">
                            <h6 class="fw-bold text-dark mb-1">
                                Ethical considerations in AI deployment for
                                public health services
                            </h6>
                            <p class="small text-muted mb-0">
                                Journal of Medical Systems (2023) • A. Silva, R.
                                Rojas.
                            </p>
                        </div>
                        <div class="mb-0">
                            <h6 class="fw-bold text-dark mb-1">
                                Optimización de procesos madereros mediante
                                visión artificial
                            </h6>
                            <p class="small text-muted mb-0">
                                Congreso Chileno de Ingeniería (2023).
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {
        noticiasSeguras && noticiasSeguras.length > 0 && (
            <section class="py-6 bg-light-subtle">
                <div class="container">
                    <div class="text-center mb-5">
                        <h6 class="text-ufro fw-bold text-uppercase ls-2">
                            Actualidad
                        </h6>
                        <h2 class="fw-bold text-dark">Noticias y Eventos</h2>
                    </div>
                    <div class="row g-4 justify-content-center">
                        {noticiasSeguras.map((n) => (
                            <div class="col-md-4">
                                <div class="card h-100 border-0 bg-white shadow-sm hover-up position-relative">
                                    {" "}
                                    <div class="card-body p-4">
                                        <small
                                            class="text-primary fw-bold mb-2 d-block text-uppercase"
                                            style="font-size: 0.7rem;"
                                        >
                                            {n.categoria || "Novedades"}
                                        </small>
                                        <h5 class="fw-bold mb-3">
                                            <a
                                                href={`/noticias/${n.id}`}
                                                class="text-dark text-decoration-none stretched-link"
                                            >
                                                {n.titulo}
                                            </a>
                                        </h5>
                                        <p class="text-muted small mb-0 line-clamp-3">
                                            {n.bajada}
                                        </p>
                                    </div>
                                    <div class="card-footer bg-white border-0 px-4 pb-4 pt-0">
                                        <small class="text-muted">
                                            <i class="bi bi-calendar3 me-1" />{" "}
                                            {new Date(
                                                n.created_at,
                                            ).toLocaleDateString()}
                                        </small>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </section>
        )
    }

    <section class="py-5 border-top bg-white">
        <div class="container text-center">
            <p class="small text-uppercase text-muted fw-bold mb-4 ls-2">
                Colaboración y Vinculación
            </p>
            <div
                class="d-flex justify-content-center align-items-center gap-5 flex-wrap opacity-50 mb-5 grayscale-logos"
            >
                <i class="bi bi-buildings fs-1" title="Empresa"></i>
                <i class="bi bi-hospital fs-1" title="Salud"></i>
                <i class="bi bi-bank fs-1" title="Gobierno"></i>
                <i class="bi bi-globe-americas fs-1" title="Internacional"></i>
            </div>

            <div class="bg-light rounded-4 p-5 mt-5 border">
                <h3 class="fw-bold text-ufro mb-3">
                    ¿Tienes un desafío tecnológico?
                </h3>
                <p class="text-muted mb-4 mx-auto" style="max-width: 600px;">
                    Buscamos socios estratégicos en la industria y el sector
                    público para desarrollar proyectos de I+D conjuntos.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a
                        href="mailto:contacto.ci2a2@ufro.cl"
                        class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm"
                    >
                        Contáctanos
                    </a>
                </div>
            </div>
        </div>
    </section>
</MainLayout>

<style>
    :root {
        --ufro-blue: #003767;
        --ufro-cyan: #009fe3;
    }
    .text-ufro {
        color: var(--ufro-blue);
    }
    .bg-ufro {
        background-color: var(--ufro-blue);
    }
    .text-cyan {
        color: var(--ufro-cyan);
    }

    /* ESPACIADO */
    .py-6 {
        padding-top: 5rem;
        padding-bottom: 5rem;
    }
    .ls-2 {
        letter-spacing: 2px;
    }

    .hero-section {
        min-height: 90vh;
        background: url("https://images.unsplash.com/photo-1550751827-4bd374c3f58b?q=80&w=2070&auto=format&fit=crop")
            no-repeat center center/cover;
    }
    .overlay-gradient {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(
            135deg,
            rgba(0, 55, 103, 0.95) 0%,
            rgba(0, 20, 40, 0.85) 100%
        );
    }

    .backdrop-blur {
        backdrop-filter: blur(5px);
    }
    .hover-scale {
        transition: transform 0.3s;
    }
    .hover-scale:hover {
        transform: scale(1.05);
    }

    .hover-up {
        transition:
            transform 0.3s,
            box-shadow 0.3s;
    }
    .hover-up:hover {
        transform: translateY(-8px);
        box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.1) !important;
    }

    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .grayscale-logos i {
        filter: grayscale(100%);
        transition: all 0.3s;
        cursor: default;
    }
    .grayscale-logos i:hover {
        filter: grayscale(0%);
        color: var(--ufro-blue);
        transform: scale(1.2);
    }

    .card-linea:hover .icon-box {
        background-color: var(--ufro-blue) !important;
        color: white !important;
        transition: 0.3s;
    }
</style>
