---
import MainLayout from "../layouts/MainLayout.astro";
import { supabase } from "../lib/supabase";

// --- 1. CARGA DE PROYECTOS (Status: En Curso) ---
const { data: proyectos } = await supabase
    .from("proyectos")
    .select("*")
    .eq("status", "En curso")
    .order("created_at", { ascending: false })
    .limit(3);

// --- 2. CARGA DE NOTICIAS ---
const { data: noticias, error: errorNoticias } = await supabase
    .from("noticias")
    .select("*")
    .order("created_at", { ascending: false })
    .limit(3);

const noticiasSeguras = errorNoticias || !noticias ? [] : noticias;

// --- 3. CARGA DE PUBLICACIONES (NUEVO) ---
const { data: publicaciones } = await supabase
    .from("publicaciones")
    .select("*")
    .eq("is_visible", true)
    .order("year", { ascending: false })
    .limit(3);

// --- 4. CARGA DE BANNERS CON FALLBACK ---
const { data: bannersRes, error: errorBanners } = await supabase
    .from("banners")
    .select("*")
    .eq("active", true)
    .order("order", { ascending: true });

// Si hay error o no hay datos, enviamos un array vacío para que el HTML sepa qué hacer
const { data: bannersSeguros } = await supabase
    .from("banners")
    .select("*")
    .eq("active", true) // Solo los visibles al público
    .order("order", { ascending: true }); // Respetar el orden del arrastre
const lineasInvestigacion = [
    {
        titulo: "Smart Agro",
        desc: "IA para la gestión hídrica y optimización de cultivos.",
        icon: "bi-flower1",
    },
    {
        titulo: "Salud y Bienestar",
        desc: "Diagnóstico asistido y telemedicina inteligente.",
        icon: "bi-heart-pulse",
    },
    {
        titulo: "Industria 4.0",
        desc: "Automatización y optimización de procesos productivos.",
        icon: "bi-gear-wide-connected",
    },
    {
        titulo: "Gobernanza de Datos",
        desc: "Políticas públicas basadas en evidencia y ética de datos.",
        icon: "bi-bank",
    },
];

// Helper simple para acortar autores en la Home
function formatAuthorsHome(autoresStr: any) {
    if (!autoresStr) return "Autoría CI2A2";
    const autores = autoresStr.split(";");
    if (autores.length > 2) {
        return `${autores[0].trim()} et al.`;
    }
    return autoresStr;
}
---

<MainLayout title="Inicio"
    ><section class="bg-light py-4">
    <div class="container">
        <div id="mainBannerCarousel" class="carousel slide" data-bs-ride="carousel">
            
            <div class="carousel-inner shadow-sm rounded-4 overflow-hidden bg-white">
                {
                    bannersSeguros && bannersSeguros.length > 0 ? (
                        bannersSeguros.map((banner, index) => (
                            <div class={`carousel-item ${index === 0 ? "active" : ""}`} data-bs-interval="5000">
                                <div style={{ width: "100%", aspectRatio: "25/9", overflow: "hidden" }}>
                                    {banner.link ? (
                                        <a href={banner.link} target="_blank" rel="noopener noreferrer">
                                            <img 
                                                src={banner.image_url} 
                                                class="d-block w-100 h-100" 
                                                style={{ objectFit: "cover", objectPosition: `center ${banner.image_position || 50}%` }} 
                                            />
                                        </a>
                                    ) : (
                                        <img 
                                            src={banner.image_url} 
                                            class="d-block w-100 h-100" 
                                            style={{ objectFit: "cover", objectPosition: `center ${banner.image_position || 50}%` }} 
                                        />
                                    )}
                                </div>
                            </div>
                        ))
                    ) : (
                        <div class="carousel-item active">
                            <div style={{ width: "100%", aspectRatio: "25/9" }}>
                                <img src="/img/banner-fallback.png" class="d-block w-100 h-100" style={{ objectFit: "cover" }} />
                            </div>
                        </div>
                    )
                }
            </div>

            {
                bannersSeguros && bannersSeguros.length > 1 && (
                    <div class="custom-indicators-container">
                        <div class="carousel-indicators">
                            {bannersSeguros.map((_, index) => (
                                <button
                                    type="button"
