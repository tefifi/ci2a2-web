<style>
    :root {
        --ufro-blue: #003767;
        --ufro-pink: #d63384;
    }
    .text-ufro {
        color: var(--ufro-blue);
    }
    .bg-ufro {
        background-color: var(--ufro-blue);
    }
    .text-pink {
        color: var(--ufro-pink) !important;
    }
    .bg-pink {
        background-color: var(--ufro-pink) !important;
    }
    .btn-pink {
        background-color: var(--ufro-pink);
        color: var(--ufro-pink);
        border: none;
    }
    .btn-pink:hover {
        background-color: #b82a6f;
        color: white;
    }

    /* ESPACIADO */
    .py-6 {
        padding-top: 5rem;
        padding-bottom: 5rem;
    }
    .ls-2 {
        letter-spacing: 2px;
    }

    .hero-section {
        min-height: 90vh;
        background: url("https://images.unsplash.com/photo-1550751827-4bd374c3f58b?q=80&w=2070&auto=format&fit=crop")
            no-repeat center center/cover;
    }
    .overlay-gradient {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(
            135deg,
            rgba(0, 55, 103, 0.8) 0%,
            rgba(214, 51, 132, 0.6) 100%
        );
    }

    .backdrop-blur {
        backdrop-filter: blur(5px);
    }
    .hover-primary:hover {
        color: #d63384 !important;
    }
    .hover-scale {
        transition: transform 0.3s;
    }
    .hover-scale:hover {
        transform: scale(1.05);
    }

    .hover-up {
        transition:
            transform 0.3s,
            box-shadow 0.3s;
    }
    .hover-up:hover {
        transform: translateY(-8px);
        box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.1);
    }

    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .grayscale-logos i {
        filter: grayscale(100%);
        transition: all 0.3s;
        cursor: default;
    }
    .grayscale-logos i:hover {
        filter: grayscale(0%);
        color: var(--ufro-blue);
        transform: scale(1.2);
    }
/* Contenedor de los círculos */
    .custom-indicators-container {
        position: relative;
        display: flex;
        justify-content: center;
        padding: 20px 0 10px 0; /* Un poco más de aire */
    }

    /* Estabilizador de los indicadores */
    .custom-indicators-container .carousel-indicators {
        position: relative !important;
        margin: 0 !important;
        bottom: 0 !important;
        inset: 0 !important;
        display: flex;
        align-items: center;
        gap: 8px; /* Espacio uniforme entre botones */
    }

    /* Estilo Base Interactivo */
    .carousel-indicators [data-bs-target] {
        width: 12px !important;
        height: 12px !important;
        border-radius: 50% !important;
        background-color: #d1d5db !important; /* Gris suave */
        border: 2px solid transparent !important; /* Preparado para el hover */
        margin: 0 !important;
        opacity: 0.7 !important;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important; /* Efecto rebote suave */
        cursor: pointer;
    }

    /* Hover: Cuando pasas el mouse por encima */
    .carousel-indicators [data-bs-target]:hover {
        opacity: 1 !important;
        transform: scale(1.4);
        background-color: #9ca3af !important;
    }

    /* Estado Activo: El que está seleccionado actualmente */
    .carousel-indicators .active {
        width: 14px !important; /* Se hace un poquito más grande */
        height: 14px !important;
        background-color: var(--ufro-pink) !important;
        opacity: 1 !important;
        transform: scale(1.1);
        box-shadow: 0 0 8px rgba(var(--ufro-pink-rgb), 0.4); /* Brillo sutil si tienes la variable RGB */
    }

    /* Animación extra para el activo */
    .carousel-indicators .active::after {
        content: "";
        position: absolute;
        top: -4px;
        left: -4px;
        right: -4px;
        bottom: -4px;
        border-radius: 50%;
        border: 1px solid var(--ufro-pink);
    }

    @keyframes pulse-ring {
        0% { transform: scale(0.7); opacity: 0.5; }
        100% { transform: scale(1.5); opacity: 0; }
    }
    </style>