---
import AdminLayout from "../layouts/AdminLayout.astro";

import AdminNoticias from "../components/admin/AdminNoticias.jsx";
import AdminProyectos from "../components/admin/AdminProyectos.jsx";
import AdminColaboradores from "../components/admin/AdminColaboradores.jsx";
import AdminPublicaciones from "../components/admin/AdminPublicaciones.jsx"; 
import AdminBanners from "../components/admin/AdminBanners.jsx";
---

<AdminLayout title="Panel de Administración">
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="fw-bold text-ufro">Panel de Control</h1>
        </div>
  
        <h2 class="mb-4">Administración CI2A2</h2>

        <ul class="nav nav-pills mb-4 gap-2" id="adminTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button
                    class="nav-link active fw-bold rounded-pill px-4"
                    id="banners-tab"
                    data-bs-toggle="pill"
                    data-bs-target="#banners"
                    type="button"
                    role="tab"
                >
                    <i class="bi bi-images me-2"></i>Banners
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button
                    class="nav-link fw-bold rounded-pill px-4"
                    id="proyectos-tab"
                    data-bs-toggle="pill"
                    data-bs-target="#proyectos"
                    type="button"
                    role="tab"
                >
                    <i class="bi bi-briefcase me-2"></i>Proyectos
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button
                    class="nav-link fw-bold rounded-pill px-4"
                    id="noticias-tab"
                    data-bs-toggle="pill"
                    data-bs-target="#noticias"
                    type="button"
                    role="tab"
                >
                    <i class="bi bi-newspaper me-2"></i>Noticias
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button
                    class="nav-link fw-bold rounded-pill px-4"
                    id="colaboradores-tab"
                    data-bs-toggle="pill"
                    data-bs-target="#colaboradores"
                    type="button"
                    role="tab"
                >
                    <i class="bi bi-people me-2"></i>Colaboradores
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button
                    class="nav-link fw-bold rounded-pill px-4"
                    id="publicaciones-tab"
                    data-bs-toggle="pill"
                    data-bs-target="#publicaciones"
                    type="button"
                    role="tab"
                >
                    <i class="bi bi-book me-2"></i>Publicaciones
                </button>
            </li>
        </ul>

        <div
            class="tab-content bg-white p-4 rounded shadow-sm border"
            id="adminTabContent"
        >
            <div
                class="tab-pane fade show active"
                id="banners"
                role="tabpanel"
            >
                <AdminBanners client:only="react" />
            </div>

            <div class="tab-pane fade" id="proyectos" role="tabpanel">
                <AdminProyectos client:only="react" />
            </div>

            <div class="tab-pane fade" id="noticias" role="tabpanel">
                <AdminNoticias client:only="react" />
            </div>

            <div class="tab-pane fade" id="colaboradores" role="tabpanel">
                <AdminColaboradores client:only="react" />
            </div>

            <div class="tab-pane fade" id="publicaciones" role="tabpanel">
                <AdminPublicaciones client:only="react" />
            </div>
        </div>
    </div>
</AdminLayout>

<style>
    .text-ufro {
        color: #003767;
    }

    .nav-pills .nav-link.active {
        background-color: #003767;
        color: white;
    }
    .nav-pills .nav-link {
        color: #555;
        background-color: #f8f9fa;
        border: 1px solid #eee;
    }
</style>