---
import AdminLayout from '../layouts/AdminLayout.astro';
import AdminProyectos from '../components/AdminProyectos.jsx';
import AdminNoticias from '../components/AdminNoticias.jsx'; 
import AdminColaboradores from '../components/AdminColaboradores.jsx'; // <--- YA DESCOMENTADO

// Protección básica de ruta (puedes mejorar esto después con Auth)
---

<AdminLayout title="Panel de Administración">
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="fw-bold text-ufro">Panel de Control</h1>
            <a href="/" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-box-arrow-right"></i> Ir al Inicio
            </a>
        </div>

        <ul class="nav nav-pills mb-4 gap-2" id="adminTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-bold rounded-pill px-4" id="proyectos-tab" data-bs-toggle="pill" data-bs-target="#proyectos" type="button" role="tab">
                    <i class="bi bi-briefcase me-2"></i>Proyectos
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold rounded-pill px-4" id="noticias-tab" data-bs-toggle="pill" data-bs-target="#noticias" type="button" role="tab">
                    <i class="bi bi-newspaper me-2"></i>Noticias
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold rounded-pill px-4" id="colaboradores-tab" data-bs-toggle="pill" data-bs-target="#colaboradores" type="button" role="tab">
                    <i class="bi bi-people me-2"></i>Colaboradores
                </button>
            </li>
        </ul>

        <div class="tab-content bg-white p-4 rounded shadow-sm border" id="adminTabContent">
            
            <div class="tab-pane fade show active" id="proyectos" role="tabpanel">
                <AdminProyectos client:only="react" />
            </div>

            <div class="tab-pane fade" id="noticias" role="tabpanel">
                <AdminNoticias client:only="react" />
            </div>

            <div class="tab-pane fade" id="colaboradores" role="tabpanel">
                <AdminColaboradores client:only="react" />
            </div>

        </div>
    </div>
</AdminLayout>

<style>
    .text-ufro { color: #003767; }
    
    .nav-pills .nav-link.active {
        background-color: #003767;
        color: white;
    }
    .nav-pills .nav-link {
        color: #555;
        background-color: #f8f9fa;
        border: 1px solid #eee;
    }
</style>