---
// src/pages/proyectos.astro
export const prerender = false;

import MainLayout from "../layouts/MainLayout.astro";
import { supabase } from "../lib/supabase";

// --- CONFIGURACIÓN ---
const PROYECTOS_POR_PAGINA = 9;

const paginaActual = parseInt(Astro.url.searchParams.get("pagina") || "1");
const desde = (paginaActual - 1) * PROYECTOS_POR_PAGINA;
const hasta = desde + PROYECTOS_POR_PAGINA - 1;

// Consulta a la Base de Datos
const {
  data: proyectos,
  count,
  error,
} = await supabase
  .from("proyectos")
  .select("*", { count: "exact" })
  .order("id", { ascending: false }) 
  .range(desde, hasta);

const totalProyectos = count || 0;
const totalPaginas = Math.ceil(totalProyectos / PROYECTOS_POR_PAGINA);
const paginasArray = Array.from({ length: totalPaginas }, (_, i) => i + 1);

// Función para colores de estado (Estilo sutil: fondo suave + texto oscuro)
// MANTENEMOS TU FUNCIÓN ORIGINAL
const getStatusStyle = (status:any) => {
    if (!status) return "bg-light text-secondary border-secondary"; // Default
    const s = status.toLowerCase();
    
    // Verde suave para activos
    if (s.includes("curso") || s.includes("activo")) return "bg-success bg-opacity-10 text-success border-success"; 
    // Gris para finalizados
    if (s.includes("finalizado") || s.includes("terminado")) return "bg-secondary bg-opacity-10 text-secondary border-secondary";
    // Amarillo para planificación
    if (s.includes("plan") || s.includes("diseño")) return "bg-warning bg-opacity-10 text-dark border-warning";
    
    return "bg-primary bg-opacity-10 text-primary border-primary";
};
---

<MainLayout title="Nuestros Proyectos">
  
  {/* --- NUEVO ENCABEZADO CON FONDO AZUL --- */}
  <section class="py-5 position-relative text-white" style="background-color: #003767;">
    <div class="container text-center py-3">
        <h1 class="fw-bold display-5 mb-3">Proyectos Realizados</h1>
        <div class="d-flex justify-content-center mb-3">
            {/* Divisor blanco con opacidad */}
            <div class="rounded-pill bg-white opacity-50" style="width: 80px; height: 4px;"></div>
        </div>
        <p class="lead opacity-75">
          Conoce el estado y avance de nuestras iniciativas.
        </p>
    </div>
  </section>

  <section class="py-5 bg-light min-vh-100">
    <div class="container py-4">
      
      {/* --- GRID DE PROYECTOS (TUS TARJETAS INTACTAS) --- */}
      <div class="row g-4">
        {proyectos && proyectos.map((proyecto) => (
          <div class="col-12 col-md-6 col-lg-4 d-flex align-items-stretch">
            <a 
              href={`/proyectos/${proyecto.id}`} 
              class="text-decoration-none w-100 card-link-wrapper"
            >
              <article class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden modern-card bg-white">
                
                {/* 1. IMAGEN (Limpia, sin badges grandes estorbando) */}
                <div class="position-relative overflow-hidden card-img-wrapper" style="aspect-ratio: 4/3;">
                  {proyecto.image_url ? (
                    <img
                      src={proyecto.image_url}
                      class="w-100 h-100 object-fit-cover transition-img"
                      alt={proyecto.title}
                      style={`object-position: 50% ${proyecto.image_position ?? 50}%;`}
                    />
                  ) : (
                    <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center text-secondary">
                      <i class="bi bi-folder2-open fs-1 opacity-25"></i>
                    </div>
                  )}

                  {/* Único elemento sobre imagen: Área (Pequeño, derecha) */}
                  <div class="position-absolute top-0 end-0 m-3 z-2">
                    <span class="badge bg-white text-dark shadow-sm fw-bold px-2 py-1 rounded-2 small" style="font-size: 0.65rem; opacity: 0.9;">
                      {proyecto.area}
                    </span>
                  </div>
                </div>

                {/* 2. CONTENIDO (Aquí ponemos el estado) */}
                <div class="card-body p-4 d-flex flex-column">
                  
                  {/* FILA SUPERIOR: Fecha y Estado */}
                  <div class="d-flex justify-content-between align-items-center mb-3">
                      {/* Fecha */}
                      <div class="text-muted small fw-bold text-uppercase d-flex align-items-center gap-2" style="font-size: 0.7rem;">
                         <i class="bi bi-calendar-event opacity-50"></i>
                         {proyecto.fecha_inicio ? new Date(proyecto.fecha_inicio).getFullYear() : '---'}
                      </div>
                      
                      {/* ESTADO: Pequeño, tipo etiqueta */}
                      <span class={`badge border border-opacity-25 rounded-pill fw-bold ${getStatusStyle(proyecto.status)}`} style="font-size: 0.65rem; letter-spacing: 0.5px;">
                          {proyecto.status || "Proyecto"}
                      </span>
                  </div>

                  {/* Título */}
                  <h5 class="card-title fw-bold mb-3 text-dark lh-sm line-clamp-2" style="min-height: 2.4rem; font-size: 1.25rem;">
                    {proyecto.title}
                  </h5>
                  
                  {/* Descripción */}
                  <p class="card-text text-secondary small line-clamp-3 mb-4 flex-grow-1" style="line-height: 1.6;">
                    {proyecto.resumen || proyecto.description}
                  </p>

                  {/* Footer */}
                  <div class="mt-auto pt-3 border-top border-light w-100 d-flex justify-content-between align-items-center">
                    <span class="text-primary fw-bold small group-hover-text">Ver proyecto</span>
                    <div class="btn btn-sm btn-outline-primary rounded-circle d-flex align-items-center justify-content-center p-0" style="width: 32px; height: 32px; transition: all 0.3s ease;">
                        <i class="bi bi-arrow-right transition-icon"></i>
                    </div>
                  </div>
                </div>
              </article>
            </a>
          </div>
        ))}
      </div>

      {/* --- PAGINACIÓN --- */}
      {totalPaginas > 1 && (
        <nav class="mt-5 d-flex justify-content-center">
            <ul class="pagination gap-2">
              <li class={`page-item ${paginaActual === 1 ? "disabled" : ""}`}>
                <a class="page-link border rounded-circle text-dark shadow-sm d-flex align-items-center justify-content-center" href={`?pagina=${paginaActual - 1}`} style="width: 40px; height: 40px;">
                  <i class="bi bi-chevron-left small"></i>
                </a>
              </li>
              
              {paginasArray.map((pag) => (
                <li class="page-item">
                  <a class={`page-link border rounded-circle shadow-sm fw-bold d-flex align-items-center justify-content-center ${pag === paginaActual ? "text-white border-0" : "bg-white text-dark"}`} 
                     href={`?pagina=${pag}`}
                     style={`width: 40px; height: 40px; ${pag === paginaActual ? 'background-color: #003767 !important;' : ''}`}>
                    {pag}
                  </a>
                </li>
              ))}

              <li class={`page-item ${paginaActual === totalPaginas ? "disabled" : ""}`}>
                <a class="page-link border rounded-circle text-dark shadow-sm d-flex align-items-center justify-content-center" href={`?pagina=${paginaActual + 1}`} style="width: 40px; height: 40px;">
                  <i class="bi bi-chevron-right small"></i>
                </a>
              </li>
            </ul>
          </nav>
        )
      }
    </div>
  </section>
</MainLayout>

<style>
  /* --- ESTILOS --- */
  
  .modern-card {
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
  }
  
  /* Hover Effect */
  .card-link-wrapper:hover .modern-card {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 55, 103, 0.12) !important;
  }

  /* Zoom Imagen */
  .transition-img {
    transition: transform 0.6s ease;
  }
  .card-link-wrapper:hover .transition-img {
    transform: scale(1.08);
  }

  /* Animación flecha */
  .transition-icon {
    transition: transform 0.3s ease;
  }
  .card-link-wrapper:hover .transition-icon {
    transform: translateX(3px);
  }
  
  /* Botón circular al hover */
  .card-link-wrapper:hover .btn-outline-primary {
      background-color: #003767;
      color: white;
      border-color: #003767;
  }

  /* Texto */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>