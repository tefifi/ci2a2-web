---
import MainLayout  from '../layouts/MainLayout.astro';
import PageHeader  from '../components/common/PageHeader.astro';
import ContactForm from '../components/ContactForm.jsx';

const colaborador = Astro.url.searchParams.get('para');
---

<MainLayout title="Contacto">

  <PageHeader
    eyebrow="Vinculación y Colaboración"
    title="Canales de Contacto"
    description="Identifica el área adecuada para tu consulta."
  />

  <section class="bg-light min-vh-100 py-5">
    <div class="container">
      <div class="row g-5">

        <!-- Sidebar de información -->
        <div class="col-lg-4">
          <div class="bg-white p-4 rounded-4 shadow-sm border border-light">
            <h5 class="fw-bold mb-4 text-ufro">Información</h5>

            <div class="d-flex align-items-start mb-3">
              <div class="icon-box me-3"><i class="bi bi-geo-alt-fill"></i></div>
              <div>
                <strong class="d-block text-dark small text-uppercase">Dirección</strong>
                <span class="text-secondary small">Francisco Salazar 01145, Temuco</span>
              </div>
            </div>

            <div class="d-flex align-items-start">
              <div class="icon-box me-3"><i class="bi bi-envelope-fill"></i></div>
              <div>
                <strong class="d-block text-dark small text-uppercase">Correo General</strong>
                <a href="mailto:contacto.ci2a2@ufrontera.cl"
                   class="text-decoration-none text-secondary small hover-pink">
                  contacto.ci2a2@ufrontera.cl
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Formularios -->
        <div class="col-lg-8">
          <ul class="nav nav-pills nav-fill mb-4 bg-white p-2 rounded-4 shadow-sm border border-light"
              id="contactTab" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link active fw-bold py-3 rounded-3 tab-blue"
                      id="colaborar-tab" data-bs-toggle="pill"
                      data-bs-target="#colaborar" type="button" role="tab">
                <i class="bi bi-briefcase-fill me-2"></i>General
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link fw-bold py-3 rounded-3 tab-pink"
                      id="estudiantes-tab" data-bs-toggle="pill"
                      data-bs-target="#estudiantes" type="button" role="tab">
                <i class="bi bi-mortarboard-fill me-2"></i>Prácticas y Tesis
              </button>
            </li>
          </ul>

          <div class="tab-content" id="contactTabContent">
            <div class="tab-pane fade show active" id="colaborar" role="tabpanel">
              <ContactForm
                client:only="react"
                titulo="Alianzas y Colaboración"
                descripcion="Si eres una institución o empresa y buscas colaborar en proyectos de investigación o desarrollo con CI2A2, escríbenos aquí."
                destinatario={colaborador}
                mostrarCarrera={false}
              />
            </div>
            <div class="tab-pane fade" id="estudiantes" role="tabpanel">
              <ContactForm
                client:only="react"
                titulo="Postulación Prácticas y Tesis"
                descripcion="¿Eres estudiante y quieres realizar tu práctica profesional o tesis con nuestro equipo? Envíanos tus datos."
                mostrarCarrera={true}
              />
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

</MainLayout>

<style is:global>
  .icon-box {
    width: 35px; height: 35px;
    background-color: rgba(0, 55, 103, 0.05);
    color: var(--ufro-blue);
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
  }

  /* Pestañas de contacto */
  .nav-link.tab-blue       { color: var(--ufro-blue); }
  .nav-link.tab-blue.active {
    background: var(--ufro-blue) !important;
    color: white !important;
    box-shadow: 0 4px 12px rgba(0, 55, 103, 0.2);
  }
  .nav-link.tab-pink       { color: var(--ufro-pink); }
  .nav-link.tab-pink.active {
    background: var(--ufro-pink) !important;
    color: white !important;
    box-shadow: 0 4px 12px rgba(214, 51, 132, 0.2);
  }
  .nav-link:not(.active):hover { background-color: #f8f9fa; }
</style>