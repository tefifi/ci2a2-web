---
import MainLayout    from '../layouts/MainLayout.astro';
import PageHeader    from '../components/common/PageHeader.astro';
import StatsAndCharts from '../components/common/StatsAndCharts.astro';
import { supabase }  from '../lib/supabase';

const { data: equipo } = await supabase
  .from('colaboradores')
  .select('*')
  .order('orden', { ascending: true })
  .order('id',    { ascending: true });
---

<MainLayout title="Nosotros">

  <PageHeader
    eyebrow="Sobre nosotros"
    title="Nuestro Centro"
    description="Ciencia de Datos e Inteligencia Artificial desde La Araucanía"
  />

  <!-- MISIÓN / VISIÓN / PROPÓSITO -->
  <section class="py-5 bg-white">
    <div class="container py-4">
      <div class="row g-5 align-items-center">
        <div class="col-lg-6">
          <img
            src="https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&q=80&w=1000"
            alt="Equipo UFRO"
            class="img-fluid rounded-4 shadow-lg"
          />
        </div>
        <div class="col-lg-6">
          <div class="mb-4">
            <h5 class="text-ufro fw-bold text-uppercase ls-1 mb-3">Nuestra Misión</h5>
            <p class="text-muted lead fs-6">
              Liderar la investigación aplicada en Inteligencia Artificial con un enfoque inter y
              transdisciplinario, articulando las capacidades de la Universidad de La Frontera para
              resolver desafíos territoriales y nacionales.
            </p>
          </div>
          <div class="mb-4">
            <h5 class="text-ufro fw-bold text-uppercase ls-1 mb-3">Nuestra Visión</h5>
            <p class="text-muted lead fs-6">
              Ser un referente nacional e internacional en IA aplicada, contribuyendo al desarrollo
              sostenible de La Araucanía a través de la transferencia tecnológica, la formación de
              capital humano avanzado y la vinculación con el entorno.
            </p>
          </div>
          <div>
            <h5 class="text-gradient fw-bold text-uppercase ls-1 mb-3">Propósito</h5>
            <p class="text-muted lead fs-6 mb-0">
              Alinear el desarrollo tecnológico con la Estrategia Regional de Desarrollo 2040,
              promoviendo la equidad territorial y la preservación del patrimonio mediante el
              uso ético de los datos.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <StatsAndCharts />

  <!-- EQUIPO -->
  <section class="py-5 team-section-bg">
    <div class="container pt-3">
      <div class="text-center mb-5">
        <h2 class="fw-bold text-dark">Nuestro Equipo</h2>
        <div class="mx-auto mt-2 mb-3" style="width: 60px; height: 4px; background: var(--gradient-main); border-radius: 4px;"></div>
        <p class="text-muted">Investigadores y profesionales detrás del CI²A²</p>
      </div>

      <div class="row g-4">
        {equipo && equipo.length > 0 ? equipo.map((c: any) => (
          <div class="col-sm-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm text-center p-4 hover-up-pink team-card bg-white rounded-4 border-top-blue">

              <!-- Avatar -->
              <div class="mx-auto mb-3 overflow-hidden rounded-circle shadow-sm" style="width: 140px; height: 140px;">
                <img
                  src={c.foto_url || `https://ui-avatars.com/api/?name=${encodeURIComponent(c.nombre)}&background=random`}
                  class="w-100 h-100 object-fit-cover img-zoom"
                  alt={c.nombre}
                />
              </div>

              <h5 class="fw-bold mb-1 text-dark name-text">{c.nombre}</h5>
              <span class="badge badge-role mb-3 rounded-pill px-3 mt-2 fw-normal">{c.cargo}</span>
              <span class="small text-muted d-block mb-2 fst-italic">{c.facultad}</span>

              {c.bio && (
                <p class="small text-muted mb-3 line-clamp-3 opacity-75">{c.bio}</p>
              )}

              <div class="d-flex justify-content-center gap-2 mt-auto">
                <a
                  href={`/contacto?para=${encodeURIComponent(c.nombre)}`}
                  class="btn btn-sm btn-light rounded-circle social-btn"
                  title={`Contactar a ${c.nombre}`}
                >
                  <i class="bi bi-chat-text-fill text-muted"></i>
                </a>
                {c.linkedin && (
                  <a href={c.linkedin} target="_blank" class="btn btn-sm btn-light rounded-circle social-btn" title="LinkedIn">
                    <i class="bi bi-linkedin text-muted"></i>
                  </a>
                )}
              </div>

            </div>
          </div>
        )) : (
          <div class="col-12 text-center py-5">
            <p class="text-muted">Cargando equipo...</p>
          </div>
        )}
      </div>
    </div>
  </section>

</MainLayout>

<style>
  .team-section-bg {
    background: linear-gradient(to bottom, #ffffff 0%, var(--ufro-blue-soft) 100%);
  }

  .border-top-blue { border-top: 4px solid var(--ufro-blue); }

  .badge-role {
    background-color: var(--ufro-blue);
    color: #fff !important;
    box-shadow: 0 4px 6px rgba(0, 55, 103, 0.2);
    letter-spacing: 0.5px;
    padding-top: 0.5em;
    padding-bottom: 0.5em;
  }

  /* Zoom avatar */
  .team-card:hover .img-zoom { transform: scale(1.15); }

  /* Subrayado nombre al hover */
  .name-text { transition: color 0.3s; }
  .team-card:hover .name-text {
    color: var(--ufro-blue) !important;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .social-btn {
    width: 38px; height: 38px;
    display: flex; align-items: center; justify-content: center;
    border: 1px solid #eee;
    transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .social-btn:hover { transform: scale(1.2); background-color: var(--ufro-pink); border-color: var(--ufro-pink); }
  .social-btn:hover i { color: white !important; }
</style>