---
import MainLayout    from '../layouts/MainLayout.astro';
import StatsAndCharts from '../components/common/StatsAndCharts.astro';
---

<MainLayout title="Nosotros">

  <section class="py-5 text-white position-relative overflow-hidden shadow-sm"
           style="background: linear-gradient(135deg, #003767 40%, #d63384 100%);">
    <div class="container position-relative z-2">
      <div class="col-lg-8">
        <h6 class="fw-bold text-uppercase mb-2" style="color:#ff85c0; letter-spacing:2px;">Sobre nosotros</h6>
        <h1 class="display-5 fw-bold mb-2">Nuestro Centro</h1>
        <p class="opacity-90 mb-0 lead small">Ciencia de Datos e Inteligencia Artificial desde La Araucanía</p>
      </div>
    </div>
  </section>

  <!-- MISIÓN / VISIÓN / PROPÓSITO -->
  <section class="py-5 bg-white">
    <div class="container py-4">
      <div class="row g-5 align-items-center">
        <div class="col-lg-6">
          <img
            src="https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&q=80&w=1000"
            alt="Equipo UFRO"
            class="img-fluid rounded-4 shadow-lg"
          />
        </div>
        <div class="col-lg-6">
          <div class="mb-4">
            <h5 class="text-ufro fw-bold text-uppercase ls-1 mb-3">Nuestra Misión</h5>
            <p class="text-muted lead fs-6">
              Liderar la investigación aplicada en Inteligencia Artificial con un enfoque inter y
              transdisciplinario, articulando las capacidades de la Universidad de La Frontera para
              resolver desafíos territoriales y nacionales.
            </p>
          </div>
          <div class="mb-4">
            <h5 class="text-ufro fw-bold text-uppercase ls-1 mb-3">Nuestra Visión</h5>
            <p class="text-muted lead fs-6">
              Ser un referente nacional e internacional en IA aplicada, contribuyendo al desarrollo
              sostenible de La Araucanía a través de la transferencia tecnológica, la formación de
              capital humano avanzado y la vinculación con el entorno.
            </p>
          </div>
          <div>
            <h5 class="text-gradient fw-bold text-uppercase ls-1 mb-3">Propósito</h5>
            <p class="text-muted lead fs-6 mb-0">
              Alinear el desarrollo tecnológico con la Estrategia Regional de Desarrollo 2040,
              promoviendo la equidad territorial y la preservación del patrimonio mediante el
              uso ético de los datos.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <StatsAndCharts />


</MainLayout>

<style>
  .ls-1 { letter-spacing: 1px; }
  .text-ufro { color: var(--ufro-blue); }
  .text-gradient {
    background: var(--gradient-main);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .btn-equipo {
    background: var(--ufro-blue);
    color: #fff;
    border: 2px solid var(--ufro-blue);
    transition: background 0.2s, box-shadow 0.2s, transform 0.2s;
  }
  .btn-equipo:hover {
    background: var(--ufro-pink);
    border-color: var(--ufro-pink);
    color: #fff;
    box-shadow: 0 8px 24px rgba(214,51,132,.3);
    transform: translateY(-2px);
  }
</style>