---
import MainLayout from '../../../layouts/MainLayout.astro';
import { supabase } from '../../../lib/supabase';

export const prerender = false;

const { categoria, id } = Astro.params;

const CATEGORIAS: Record<string, { label: string }> = {
  'investigadores':            { label: 'Investigadores' },
  'investigadores-asociados':  { label: 'Investigadores Asociados' },
  'cientificos':               { label: 'Científicos' },
  'profesionales':             { label: 'Ingenieros y Profesionales' },
  'postdocs':                  { label: 'Postdoctorados' },
  'profesores-distinguidos':   { label: 'Profesores Distinguidos' },
  'investigadores-visitantes': { label: 'Investigadores Visitantes' },
  'staff':                     { label: 'Staff' },
};

const meta = categoria ? CATEGORIAS[categoria] : null;
if (!meta) return Astro.redirect('/equipo');

const { data: p, error } = await supabase
  .from('colaboradores')
  .select('*')
  .eq('id', id)
  .single();

if (error || !p) return Astro.redirect(`/equipo/${categoria}`);

const fotoSrc = p.foto_url || `https://ui-avatars.com/api/?name=${encodeURIComponent(p.nombre)}&background=003767&color=fff&size=400`;

const lineasFormacion: string[] = p.titulo_academico
  ? p.titulo_academico.split('\n').filter((l: string) => l.trim())
  : [];

const lineasArea: string[] = p.area_investigacion
  ? p.area_investigacion.split('\n').filter((l: string) => l.trim())
  : [];

const lineasGrupos: string[] = p.grupos_trabajo
  ? p.grupos_trabajo.split('\n').filter((l: string) => l.trim())
  : [];
---

<MainLayout title={p.nombre}>

  <!-- Hero -->
  <section class="py-5 text-white position-relative overflow-hidden shadow-sm"
           style="background: linear-gradient(135deg, #003767 40%, #d63384 100%);">
    <div class="container position-relative z-2">
      <div class="col-lg-8">
        <h6 class="fw-bold text-uppercase mb-2" style="color:#ff85c0; letter-spacing:2px;">
          <a href={`/equipo/${categoria}`} class="text-decoration-none" style="color:#ff85c0;">{meta.label}</a>
        </h6>
        <h1 class="display-5 fw-bold mb-2">{p.nombre}</h1>
        {p.cargo && <p class="opacity-90 mb-0 lead small">{p.cargo}</p>}
      </div>
    </div>
  </section>

  <section class="py-5 bg-white">
    <div class="container">

      <!-- Layout principal: foto | columna derecha -->
      <div class="row g-4 mb-4">

        <!-- Foto -->
        <div class="col-auto d-none d-md-block">
          <div class="overflow-hidden rounded-4 shadow-sm" style="width:200px; height:240px;">
            <img src={fotoSrc} class="w-100 h-100 object-fit-cover" alt={p.nombre} />
          </div>
        </div>

        <!-- Foto móvil (centrada) -->
        <div class="col-12 d-md-none text-center">
          <div class="overflow-hidden rounded-4 shadow-sm d-inline-block" style="width:160px; height:190px;">
            <img src={fotoSrc} class="w-100 h-100 object-fit-cover" alt={p.nombre} />
          </div>
        </div>

        <!-- Datos -->
        <div class="col">

          <!-- Fila 1: campos cortos -->
          <div class="row g-3 mb-3">
            {p.institucion && (
              <div class="col-sm-6 col-lg-4">
                <span class="ficha-label d-block">Institución</span>
                <span class="ficha-value">{p.institucion}</span>
              </div>
            )}
            {p.facultad && (
              <div class="col-sm-6 col-lg-4">
                <span class="ficha-label d-block">Facultad</span>
                <span class="ficha-value">{p.facultad}</span>
              </div>
            )}
            {p.jerarquia && (
              <div class="col-sm-6 col-lg-4">
                <span class="ficha-label d-block">Jerarquía</span>
                <span class="ficha-value">{p.jerarquia}</span>
              </div>
            )}
          </div>

          <!-- Fila 2: área de investigación como badges -->
          {lineasArea.length > 0 && (
            <div class="mb-3">
              <span class="ficha-label d-block mb-2">Área de Investigación</span>
              <div class="d-flex flex-wrap gap-2">
                {lineasArea.map((area: string) => (
                  <span class="badge-area">{area}</span>
                ))}
              </div>
            </div>
          )}

          <!-- Fila 3: grupos de trabajo como badges -->
          {lineasGrupos.length > 0 && (
            <div class="mb-3">
              <span class="ficha-label d-block mb-2">Grupos de Trabajo</span>
              <div class="d-flex flex-wrap gap-2">
                {lineasGrupos.map((grupo: string) => (
                  <span class="badge-grupo">{grupo}</span>
                ))}
              </div>
            </div>
          )}

          <!-- Fila 4: teléfono + oficina -->
          {(p.telefono || p.oficina) && (
            <div class="d-flex flex-wrap gap-3 mb-3">
              {p.telefono && (
                <span class="contact-chip">
                  <i class="bi bi-telephone"></i>{p.telefono}
                </span>
              )}
              {p.oficina && (
                <span class="contact-chip">
                  <i class="bi bi-door-open"></i>Oficina {p.oficina}
                </span>
              )}
            </div>
          )}

          <!-- Fila 5: links -->
          <div class="d-flex flex-wrap gap-2">
            <a href={`/contacto?para=${encodeURIComponent(p.nombre)}`} class="link-btn contactar">
              <i class="bi bi-envelope"></i>Contactar
            </a>
            {p.linkedin && (
              <a href={p.linkedin} target="_blank" rel="noopener" class="link-btn linkedin">
                <i class="bi bi-linkedin"></i>LinkedIn
              </a>
            )}
            {p.github && (
              <a href={p.github} target="_blank" rel="noopener" class="link-btn">
                <i class="bi bi-github"></i>GitHub
              </a>
            )}
            {p.google_scholar && (
              <a href={p.google_scholar} target="_blank" rel="noopener" class="link-btn">
                <i class="bi bi-mortarboard"></i>Google Scholar
              </a>
            )}
            {p.orcid && (
              <a href={`https://orcid.org/${p.orcid}`} target="_blank" rel="noopener" class="link-btn">
                <i class="bi bi-person-badge"></i>ORCID
              </a>
            )}
            {p.researchgate && (
              <a href={p.researchgate} target="_blank" rel="noopener" class="link-btn">
                <i class="bi bi-graph-up"></i>ResearchGate
              </a>
            )}
          </div>

        </div>
      </div>

      <!-- Formación académica -->
      {lineasFormacion.length > 0 && (
        <div class="mb-4 p-4 rounded-4 border-start border-4"
             style="border-color: var(--ufro-pink) !important; background: #fafbfd;">
          <p class="ficha-label mb-2">Formación Académica</p>
          {lineasFormacion.map((linea: string) => (
            <p class="mb-1 text-dark small lh-sm">{linea}</p>
          ))}
        </div>
      )}

      <!-- Bio -->
      {p.bio && (
        <div class="profile-bio" set:html={p.bio} />
      )}

      <!-- Volver -->
      <div class="mt-4 pt-2 border-top">
        <a href={`/equipo/${categoria}`} class="btn-volver">
          <i class="bi bi-arrow-left volver-arrow"></i>
          Volver a {meta.label}
        </a>
      </div>

    </div>
  </section>

</MainLayout>

<style>
  .ficha-label {
    font-size: .68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .5px;
    color: #9ca3af;
    margin-bottom: 2px;
  }
  .ficha-value { font-size: .875rem; color: #1f2937; line-height: 1.4; }

  /* Badges área de investigación */
  .badge-area {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 50px;
    font-size: .78rem;
    font-weight: 500;
    background: var(--ufro-blue-soft, #e8f0f7);
    color: var(--ufro-blue);
    line-height: 1.4;
  }

  /* Badges grupos de trabajo */
  .badge-grupo {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 50px;
    font-size: .78rem;
    font-weight: 500;
    background: #f3f4f6;
    color: #374151;
    border: 1px solid #e5e7eb;
    line-height: 1.4;
  }

  .contact-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: .82rem;
    color: #6b7280;
    padding: 4px 0;
  }
  .contact-chip i { color: var(--ufro-blue); }

  .link-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 50px;
    font-size: .78rem;
    font-weight: 500;
    border: 1px solid #d1d5db;
    color: #374151;
    text-decoration: none;
    transition: all .2s;
    background: #fff;
  }
  .link-btn:hover { border-color: var(--ufro-blue); color: var(--ufro-blue); background: var(--ufro-blue-soft, #e8f0f7); }
  .link-btn.linkedin { background: #0a66c2; color: #fff; border-color: #0a66c2; }
  .link-btn.linkedin:hover { background: #0958a8; border-color: #0958a8; color: #fff; }
  .link-btn.contactar { background: var(--ufro-blue); color: #fff; border-color: var(--ufro-blue); }
  .link-btn.contactar:hover { background: #002a52; border-color: #002a52; color: #fff; }

  .btn-volver {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 20px;
    border-radius: 50px;
    font-size: .875rem;
    font-weight: 600;
    background: var(--ufro-pink);
    color: #fff;
    text-decoration: none;
    border: 2px solid var(--ufro-pink);
    transition: background 0.2s, box-shadow 0.2s, transform 0.2s;
  }
  .btn-volver:hover {
    background: #b8296f;
    border-color: #b8296f;
    color: #fff;
    box-shadow: 0 6px 18px rgba(214,51,132,.35);
    transform: translateY(-2px);
  }
  .volver-arrow { transition: transform 0.25s cubic-bezier(.34,1.56,.64,1); }
  .btn-volver:hover .volver-arrow { transform: translateX(-4px); }

  .profile-bio { font-size: 1rem; line-height: 1.85; color: #4b5563; }
  .profile-bio p { margin-bottom: 1.2rem; }
  .profile-bio h2, .profile-bio h3 {
    font-weight: 700;
    color: var(--ufro-blue);
    margin-top: 2rem;
    margin-bottom: .75rem;
  }
</style>