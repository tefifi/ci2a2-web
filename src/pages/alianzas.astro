---
import MainLayout  from '../layouts/MainLayout.astro';
import PageHeader  from '../components/common/PageHeader.astro';
import { supabase } from '../lib/supabase';

// ── Datos ──────────────────────────────────────────────────────────────────
let alianzas: any[] = [];
const { data, error } = await supabase
  .from('alianzas')
  .select('*')
  .order('nombre', { ascending: true });

if (!error) alianzas = data || [];

// ── Agrupación dinámica ────────────────────────────────────────────────────
const ORDEN_PRIORIDAD = ['Clientes', 'Alianzas', 'Universidades Socias', 'Ecosistema'];

const normalizarCategoria = (valor: any): string => {
  if (!valor) return 'General';
  const v = valor.trim();
  if (v === 'Cliente')           return 'Clientes';
  if (v === 'Alianza')           return 'Alianzas';
  if (v === 'Universidad Socia') return 'Universidades Socias';
  return v.charAt(0).toUpperCase() + v.slice(1);
};

const alianzasPorCategoria: Record<string, any[]> = alianzas.reduce((acc, item) => {
  const cat = normalizarCategoria(item.tipo_entidad || item.categoria);
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(item);
  return acc;
}, {});

const encontradas   = Object.keys(alianzasPorCategoria);
const categoriasAmostrar = [
  ...ORDEN_PRIORIDAD.filter(c => encontradas.includes(c)),
  ...encontradas.filter(c => !ORDEN_PRIORIDAD.includes(c)).sort(),
];

const FALLBACK_LOGO = 'https://via.placeholder.com/400x300?text=Sin+Logo';
---

<MainLayout title="Alianzas y Convenios">

  <PageHeader
    eyebrow="Vinculación"
    title="Nuestra Red"
    description="Conectando la academia con la industria y el mundo."
  />

  <section class="py-5 bg-light">
    <div class="container py-4">

      {categoriasAmostrar.map((categoria) => (
        <div class="mb-5 animate-on-scroll">

          <!-- Título de sección -->
          <div class="d-flex align-items-center gap-3 mb-4">
            <h3 class="fw-bold text-ufro mb-0">{categoria}</h3>
            <div class="divider-pink"></div>
          </div>

          <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
            {alianzasPorCategoria[categoria].map((item: any) => {
              const linkUrl = item.link_web;
              return (
                <div class="col">
                  <div class="card h-100 border-0 shadow-sm hover-up team-card overflow-hidden bg-white">

                    <!-- Contenedor de logo -->
                    {linkUrl ? (
                      <a
                        href={linkUrl} target="_blank" rel="noopener noreferrer"
                        class="position-relative overflow-hidden d-block logo-container"
                        style="height: 220px; border-bottom: 1px solid #f0f0f0;"
                      >
                        <img
                          src={item.logo_url || FALLBACK_LOGO}
                          alt={item.nombre}
                          class="w-100 h-100 object-fit-contain p-4 img-zoom"
                          loading="lazy"
                          onerror={`this.src='${FALLBACK_LOGO}'`}
                        />
                        {item.pais && (
                          <div class="position-absolute top-0 end-0 m-3 z-2">
                            <span class="badge bg-light text-dark shadow-sm border fw-normal" style="font-size: 0.7rem;">
                              {item.pais}
                            </span>
                          </div>
                        )}
                      </a>
                    ) : (
                      <div
                        class="position-relative overflow-hidden d-block logo-container"
                        style="height: 220px; border-bottom: 1px solid #f0f0f0;"
                      >
                        <img
                          src={item.logo_url || FALLBACK_LOGO}
                          alt={item.nombre}
                          class="w-100 h-100 object-fit-contain p-4 img-zoom"
                          loading="lazy"
                          onerror={`this.src='${FALLBACK_LOGO}'`}
                        />
                        {item.pais && (
                          <div class="position-absolute top-0 end-0 m-3 z-2">
                            <span class="badge bg-light text-dark shadow-sm border fw-normal" style="font-size: 0.7rem;">
                              {item.pais}
                            </span>
                          </div>
                        )}
                      </div>
                    )}

                    <!-- Cuerpo -->
                    <div class="card-body text-center p-4 d-flex flex-column">
                      <h5 class="fw-bold text-dark mb-1 fs-6 line-clamp-2">
                        {item.nombre || item.nombre_contraparte}
                      </h5>
                      <p class="text-muted small mb-3 flex-grow-1">
                        {item.descripcion || 'Convenio de colaboración'}
                      </p>

                      <!-- Pie -->
                      <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                        <div>
                          {item.fecha_firma ? (
                            <small class="text-muted" style="font-size: 0.75rem;">
                              <i class="bi bi-calendar3 me-1 opacity-50"></i>
                              {new Date(item.fecha_firma).getFullYear()}
                            </small>
                          ) : (
                            <small class="text-muted" style="font-size: 0.75rem;">-</small>
                          )}
                        </div>
                        {linkUrl && (
                          <a
                            href={linkUrl} target="_blank" rel="noopener noreferrer"
                            class="icon-link" title="Ir al sitio web"
                          >
                            <i class="bi bi-box-arrow-up-right"></i>
                          </a>
                        )}
                      </div>
                    </div>

                  </div>
                </div>
              );
            })}
          </div>
        </div>
      ))}

      {categoriasAmostrar.length === 0 && (
        <div class="text-center py-5">
          <p class="text-muted">No hay alianzas registradas por el momento.</p>
        </div>
      )}

    </div>
  </section>
</MainLayout>

<style>
  /* Zoom al pasar sobre logo */
  .team-card:hover .img-zoom { transform: scale(1.08); }

  /* Color de nombre al hover */
  .team-card:hover .fw-bold { color: var(--ufro-blue) !important; }

  .logo-container {
    text-decoration: none;
    background: white;
  }

  .icon-link {
    color: #adb5bd;
    font-size: 1rem;
    transition: all 0.2s ease;
    display: inline-block;
  }
  .icon-link:hover       { color: var(--ufro-pink); transform: scale(1.2); }
  .team-card:hover .icon-link { color: var(--ufro-blue); }
  .team-card:hover .icon-link:hover { color: var(--ufro-pink); }
</style>