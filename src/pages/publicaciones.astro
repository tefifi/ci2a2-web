---
import MainLayout      from '../layouts/MainLayout.astro';
import PageHeader      from '../components/common/PageHeader.astro';
import PublicacionesList from '../components/PublicacionesList.jsx';
---

<MainLayout title="Publicaciones Científicas">

  <PageHeader
    eyebrow="Iniciativas y desarrollo"
    title="Producción Científica"
    description="Explora nuestra colección de artículos, conferencias y tesis que impulsan el conocimiento."
  />

  <section class="bg-light min-vh-100 py-5">
    <div class="container">
      <PublicacionesList client:load />
    </div>
  </section>

</MainLayout>

<!--
  PublicacionesList.jsx usa clases (.modern-card, .filter-card, .btn-read-paper, etc.)
  que están definidas aquí con is:global porque el componente JSX no puede inyectarlas
  en el DOM de Astro directamente (el <style jsx> dentro del JSX no funciona en SSR).
-->
<style is:global>
  .modern-card {
    background: white;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 16px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 280px;
    position: relative;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    cursor: pointer;
  }
  .modern-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 30px rgba(214, 51, 132, 0.25) !important;
    border-color: rgba(214, 51, 132, 0.3);
  }

  /* Ícono rosado */
  .modern-card .icon-wrapper {
    display: flex;
    margin-bottom: 1rem;
    color: var(--ufro-pink);
    font-size: 1.8rem;
    transition: transform 0.3s ease;
  }
  .modern-card:hover .icon-wrapper { transform: scale(1.1); }

  /* Categoría y título */
  .modern-card h6,
  .modern-card .text-uppercase {
    color: var(--ufro-blue) !important;
    font-weight: 800;
    font-size: 0.75rem;
    letter-spacing: 0.5px;
    margin-bottom: 0.75rem;
  }
  .modern-card h5 {
    color: var(--ufro-blue) !important;
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 1.5rem;
  }

  /* Animación "Ver detalle" */
  .read-more-link {
    margin-top: auto;
    color: var(--ufro-pink) !important;
    font-weight: 600;
    font-size: 0.95rem;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .modern-card:hover .read-more-link { transform: translateX(15px); }

  /* Filtros */
  .filter-card {
    background: rgba(255,255,255,0.9);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(0,0,0,0.05);
    transition: all 0.3s ease;
  }
  .filter-label {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--ufro-blue);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 4px;
    margin-left: 2px;
  }
  .filter-input {
    background-color: #f8f9fa;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 0.6rem 0.8rem;
    transition: all 0.2s ease;
    font-size: 0.9rem;
  }
  .filter-input:focus {
    background-color: #fff;
    border-color: var(--ufro-pink);
    box-shadow: 0 0 0 4px rgba(214, 51, 132, 0.1);
    outline: none;
  }
  .btn-clear-filters {
    border: 1px dashed #dc3545;
    color: #dc3545;
    background: transparent;
    transition: all 0.2s ease;
    font-weight: 500;
  }
  .btn-clear-filters:hover {
    background: #dc3545;
    color: white;
    border-style: solid;
    transform: translateY(-2px);
  }

  /* Modal */
  .modal-backdrop-custom {
    position: fixed; inset: 0;
    background: rgba(0, 55, 103, 0.7);
    z-index: 1050;
    backdrop-filter: blur(5px);
  }
  .modal-content-custom {
    border-radius: 16px;
    border-top: 5px solid var(--ufro-pink);
  }
  .btn-read-paper {
    background-color: var(--ufro-pink);
    border-color: var(--ufro-pink);
    color: white;
    font-weight: 600;
    transition: all 0.3s ease;
  }
  .btn-read-paper:hover {
    background-color: #b02a6b;
    border-color: #b02a6b;
  }
</style>