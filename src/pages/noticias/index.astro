---
import MainLayout from "../../layouts/MainLayout.astro";
import { supabase } from "../../lib/supabase";

// Consultamos las noticias ordenadas por fecha
const { data: noticias } = await supabase
    .from("noticias")
    .select("*")
    .order("fecha", { ascending: false })
    .limit(3);

const listadoNoticias = noticias || [];
---

<MainLayout title="Noticias">
    <section
        class="py-5 text-white position-relative overflow-hidden shadow-sm"
        style="background: linear-gradient(135deg, #003767 40%, #d63384 100%);"
    >
        <div class="container position-relative z-2">
            <div class="col-lg-8">
                <h6
                    class="text-pink-light fw-bold text-uppercase ls-2 mb-2 animate-fade-in"
                >
                    Actualidad
                </h6>
                <h1 class="display-5 fw-bold mb-2">Noticias y Eventos</h1>
                <p class="opacity-90 mb-0 lead small">
                    Novedades e investigaciones del CI²A²
                </p>
            </div>
        </div>
    </section>

    <section class="py-5 bg-light">
        <div class="container">
            <div class="row g-4">
                {
                    listadoNoticias.length > 0 ? (
                        listadoNoticias.map((item) => (
<div class="col-md-6 col-lg-4 card-container">
    <div class="card h-100 border-0 shadow-sm hover-grow position-relative">
        <div class="position-relative overflow-hidden" style="height: 200px;">
            <img
                src={item.image_url || "/img/placeholder-news.jpg"}
                class="w-100 h-100 transition-img"
                style={`object-fit: cover; object-position: center ${item.image_position || 50}%;`}
                alt={item.titulo}
            />
            <div class="position-absolute top-0 start-0 m-3">
                <span class="badge bg-fica shadow-sm">
                    {item.categoria || "General"}
                </span>
            </div>
        </div>
        
        <div class="card-body p-4 d-flex flex-column">
            <small class="text-muted mb-2">
                <i class="bi bi-calendar3 me-1" />
                {item.fecha ? new Date(item.fecha).toLocaleDateString("es-CL") : "Sin fecha"}
            </small>
            
            <h5 class="fw-bold mb-3 text-dark title-hover">
                {item.titulo}
            </h5>
            
            <p class="text-secondary small line-clamp-3 mb-4 flex-grow-1">
                {item.bajada}
            </p>

            <a
                href={`/noticias/${item.id}`}
                class="btn btn-outline-fica rounded-pill btn-sm fw-bold align-self-start stretched-link mt-auto"
            >
                Leer completa
            </a>
        </div>
    </div>
</div>
                        ))
                    ) : (
                        <div class="col-12 text-center py-5">
                            <div class="alert alert-light border shadow-sm d-inline-block px-5">
                                <i class="bi bi-info-circle me-2" /> No hay
                                noticias publicadas aún.
                            </div>
                        </div>
                    )
                }
            </div>
        </div>
    </section>
</MainLayout>

<style>
    /* Colores */
    .bg-fica { background-color: #d63384; }
    .text-pink-light { color: #ff85c0; }

    /* Botón */
    .btn-outline-fica {
        color: #d63384;
        border: 2px solid #d63384;
        transition: all 0.3s ease;
        z-index: 2; /* Asegura que el botón esté sobre el link estirado para estilo */
    }

    /* --- SOLUCIÓN DEFINITIVA: CLICK ÚNICO Y SIN VIBRACIÓN --- */
    
    /* La tarjeta base no se mueve al hover directo */
    .hover-grow {
        cursor: pointer;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        overflow: hidden;
    }

    /* El efecto se dispara desde el contenedor padre (estático) */
    .card-container:hover .hover-grow {
        transform: translateY(-8px);
        box-shadow: 0 12px 24px rgba(214, 51, 132, 0.2) !important;
    }

    /* Forzamos que el link estirado sea siempre el tope del área de click */
    .stretched-link {
        z-index: 3;
    }

    /* Reactividad de imagen y texto */
    .transition-img { transition: transform 0.5s ease; }
    .card-container:hover .transition-img {
        transform: scale(1.1);
    }

    .title-hover { transition: color 0.3s ease; }
    .card-container:hover .title-hover {
        color: #d63384 !important;
        text-decoration: underline;
    }

    /* Estilos de texto */
    .ls-2 { letter-spacing: 2px; }
    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>