---
import MainLayout from "../../layouts/MainLayout.astro";
import { supabase } from "../../lib/supabase";

const { id } = Astro.params;

const { data: noticia, error } = await supabase
    .from("noticias")
    .select("*")
    .eq("id", id)
    .single();

if (error || !noticia) {
    return Astro.redirect("/noticias");
}

export const prerender = false;
---

<MainLayout title={noticia.titulo}>
    <article class="bg-white min-vh-100">
        <div class="container pt-5">
            <div class="col-lg-10 mx-auto">
                <a
                    href="/noticias"
                    class="text-decoration-none small mb-3 d-inline-block back-link"
                >
                    <i class="bi bi-arrow-left me-1 transition-icon"></i> Volver a
                    Noticias
                </a>
                <div>
                    <span
                        class="badge mb-3 px-3 py-2 fw-bold"
                        style="background-color: #d63384; color: white;"
                    >
                        {noticia.categoria || "Novedad"}
                    </span>
                </div>
                <h1 class="display-5 fw-bold mb-3 text-dark">
                    {noticia.titulo}
                </h1>
                <div
                    class="d-flex align-items-center gap-3 text-muted small mb-4"
                >
                    <span
                        ><i class="bi bi-calendar3 me-2"></i>{
                            noticia.fecha
                                ? new Date(noticia.fecha).toLocaleDateString(
                                      "es-CL",
                                      {
                                          weekday: "long",
                                          year: "numeric",
                                          month: "long",
                                          day: "numeric",
                                      },
                                  )
                                : ""
                        }</span
                    >
                </div>
            </div>
        </div>

        <div class="container mb-5">
            <div class="col-lg-10 mx-auto text-center">
                <img
                    src={noticia.image_url}
                    class="img-fluid rounded-4 shadow-sm"
                    style={{
                        maxWidth: "900px",
                        maxHeight: "600px",
                        width: "100%",
                        objectFit: "cover",
                        objectPosition: `center ${noticia.image_position || 50}%`,
                    }}
                    alt={noticia.titulo}
                />
            </div>
        </div>

        <div class="container pb-5">
            <div class="row">
                <div class="col-lg-8 mx-auto">
                    <div
                        class="lead fw-bold text-secondary mb-5 fst-italic border-start border-4 ps-4"
                        style="border-color: #d63384 !important;"
                    >
                        {noticia.bajada}
                    </div>

                    <div
                        class="content-body text-dark"
                        set:html={noticia.cuerpo}
                    />

                    <hr class="my-5 opacity-25" />

                    {
                        noticia.colaboradores &&
                            Array.isArray(noticia.colaboradores) &&
                            noticia.colaboradores.length > 0 && (
                                <div class="mt-4 pt-3 border-top mb-5">
                                    <span class="small text-muted fw-bold text-uppercase d-block mb-2">
                                        <i class="bi bi-pen-fill me-1" />{" "}
                                        Autores:
                                    </span>
                                    <div class="d-flex flex-wrap gap-2">
                                        {noticia.colaboradores.map(
                                            (autor: any) => (
                                                <span class="badge bg-light text-secondary border rounded-pill px-3 py-2">
                                                    {autor}
                                                </span>
                                            ),
                                        )}
                                    </div>
                                </div>
                            )
                    }

                    <div class="text-center">
                        <div class="text-center mt-5">
                            <a
                                href="/noticias"
                                class="btn rounded-pill px-5 custom-btn-fica"
                                style="border: 2px solid #d63384; color: #d63384; font-weight: bold;"
                            >
                                Ver más noticias
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </article>
</MainLayout>

<style>
    .back-link {
        color: #6c757d; /* Gris secundario base */
        transition: all 0.3s ease;
        font-weight: 500;
    }

    /* Efecto al pasar el mouse */
    .back-link:hover {
        color: #d63384; /* Cambia a rosado FICA */
        transform: translateX(
            -5px
        ); /* Desplaza todo el bloque un poco a la izquierda */
    }

    /* Efecto específico para la flecha */
    .back-link i {
        display: inline-block;
        transition: transform 0.3s ease;
    }

    .back-link:hover i {
        transform: scale(1.2); /* Agranda un poquito la flecha */
    }

    .hover-opacity:hover {
        opacity: 0.8;
        text-decoration: underline;
    }

    .content-body :global(p) {
        margin-bottom: 1.5rem;
        line-height: 2;
        color: #333;
        font-size: 1.15rem;
    }

    .content-body :global(h2),
    .content-body :global(h3) {
        color: #003767;
        font-weight: bold;
        margin-top: 2.5rem;
        margin-bottom: 1rem;
    }

    .custom-btn-fica {
        background-color: transparent;
        transition: all 0.3s ease;
    }

    .custom-btn-fica:hover {
        background-color: #d63384 !important;
        color: white !important;
        transform: translateY(-3px);
        box-shadow: 0 5px 15px rgba(214, 51, 132, 0.3);
    }

    .border-fica {
        border-color: #d63384 !important;
    }
</style>
