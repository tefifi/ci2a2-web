# Copia este archivo como scripts/.env.scrapers y completa los valores reales.
# scripts/.env.scrapers NO debe subirse a git (ya está en .gitignore).
# Esta key es distinta de la anon key que usa el sitio — sácala de
# Supabase → Settings → API → Project API keys → service_role.

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui
